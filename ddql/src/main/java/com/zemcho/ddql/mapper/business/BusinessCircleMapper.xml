<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.zemcho.ddql.mapper.business.BusinessCircleMapper">

    <sql id="field">
        cover_image_url,
        logo_image_url,
        name,
        location,
        location_name,
        sort_order,
        status,
        description,
        remark,
        create_time,
        update_time
    </sql>

    <insert id="insert" keyProperty="id" useGeneratedKeys="true">
        INSERT INTO `business_circle`
        (<include refid="field"/>)
        VALUES
        (
        #{data.coverImageUrl},
        #{data.logoImageUrl},
        #{data.name},
        #{data.location},
        #{data.locationName},
        #{data.sortOrder},
        #{data.status},
        #{data.description},
        #{data.remark},
        #{data.createTime},
        #{data.updateTime}
        )
    </insert>

    <update id="update">
        UPDATE `business_circle`
        <set>
            <if test="data.coverImageUrl != null and data.coverImageUrl != ''">
                cover_image_url = #{data.coverImageUrl},
            </if>
            <if test="data.logoImageUrl != null and data.logoImageUrl != ''">
                logo_image_url = #{data.logoImageUrl},
            </if>
            <if test="data.name != null and data.name != ''">
                name = #{data.name},
            </if>
            <if test="data.location != null and data.location != ''">
                location = #{data.location},
            </if>
            <if test="data.locationName != null and data.locationName != ''">
                location_name = #{data.locationName},
            </if>
            <if test="data.sortOrder != null">
                sort_order = #{data.sortOrder},
            </if>
            <if test="data.status != null">
                status = #{data.status},
            </if>
            <if test="data.description != null and data.description != ''">
                description = #{data.description},
            </if>
            <if test="data.remark != null and data.remark != ''">
                remark = #{data.remark},
            </if>
        </set>
        WHERE id = #{data.id}
    </update>

    <select id="selectList" resultType="com.zemcho.ddql.controller.business.vo.BusinessCircleVo">
        SELECT *
        FROM `business_circle`
        <where>
            <if test="param.searchId != null">
                AND id = #{param.searchId}
            </if>
            <if test="param.keyword != null and param.keyword != ''">
                AND name LIKE CONCAT('%', #{param.keyword}, '%')
            </if>
            <if test="param.searchIntStatus != null">
                AND status = #{param.searchIntStatus}
            </if>
            <if test="param.startTime != null">
                AND create_time &gt;= #{param.startTime}
            </if>
            <if test="param.endTime != null">
                AND create_time &lt;= #{param.endTime}
            </if>
        </where>
        ORDER BY sort_order DESC , create_time DESC
    </select>

    <select id="selectById" resultType="com.zemcho.ddql.entity.business.BusinessCircle">
        SELECT *
        FROM business_circle
        WHERE id = #{id}
    </select>
    <select id="selectByName" resultType="com.zemcho.ddql.entity.business.BusinessCircle">
        SELECT *
        FROM business_circle
        WHERE name = #{name}
        <if test="id != null">
            AND id != #{id}
        </if>
    </select>
    <select id="selectByShopIds" resultType="com.zemcho.ddql.controller.business.vo.ShopCircleListVO">
        SELECT
            bcs.circle_id AS circleId,
            bcs.shop_id AS shopId,
            bc.name AS circleName
        FROM business_circle_shop bcs
        left join business_circle bc on bcs.circle_id = bc.id
        WHERE bcs.shop_id IN
        <foreach item="item" collection="shopIds" separator="," open="(" close=")">
            #{item}
        </foreach>
    </select>

    <delete id="deleteByIds">
        DELETE FROM business_circle WHERE id IN
        <foreach item="item" collection="ids" separator="," open="(" close=")">
            #{item}
        </foreach>
    </delete>

    <select id="selectCommonList" resultType="com.zemcho.ddql.controller.common.vo.BusinessCircleCommonVo">
        SELECT *
        FROM `business_circle`
        <where>
            <if test="param.keyword != null and param.keyword != ''">
                AND `name` LIKE CONCAT('%', #{param.keyword}, '%')
            </if>
            <if test="param.searchIntStatus != null">
                AND status = #{param.searchIntStatus}
            </if>
        </where>
        ORDER BY sort_order DESC , id DESC
    </select>
</mapper>
