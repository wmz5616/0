<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.zemcho.ddql.mapper.business.IndustryCategoryMapper">

    <insert id="insert">
        INSERT INTO `industry_category` (name, sort)
        VALUES (#{param.name}, #{param.sort})
    </insert>



    <update id="update">
        UPDATE `industry_category`
        <set>
            <if test="param.name != null and param.name != ''">
                name = #{param.name},
            </if>
        </set>
        WHERE id = #{param.id}
    </update>

    <delete id="deleteByIds">
        DELETE FROM `industry_category`
        <where>
            id IN
            <foreach collection="ids" item="item" separator="," open="(" close=")">
                #{item}
            </foreach>
        </where>
    </delete>

    <select id="selectList" resultType="com.zemcho.ddql.entity.business.IndustryCategory">
        SELECT *
        FROM `industry_category`
        ORDER BY sort
    </select>

    <select id="selectMaxSort" resultType="java.lang.Integer">
        SELECT MAX(sort)
        FROM `industry_category`
    </select>

    <select id="selectById" resultType="com.zemcho.ddql.entity.business.IndustryCategory">
        SELECT *
        FROM `industry_category`
        WHERE id = #{id}
    </select>

    <select id="selectByIds" resultType="com.zemcho.ddql.entity.business.IndustryCategory">
        SELECT *
        FROM `industry_category`
        <where>
            <if test="ids!=null">
                id IN
                <foreach collection="ids" item="item" close=")" open="(" separator=",">
                    #{item}
                </foreach>
            </if>
        </where>
    </select>

    <select id="selectByShopIds"
            resultType="com.zemcho.ddql.controller.business.vo.ShopIndustryCategoryListVO">
        SELECT
        ic.id AS industryCategoryId,
        ic.name,
        sic.shop_id
        FROM `industry_category` ic
        LEFT JOIN `shop_industry_category` sic ON ic.id = sic.industry_category_id
        WHERE sic.shop_id IN
        <foreach collection="ids" item="item" close=")" open="(" separator=",">
            #{item}
        </foreach>
    </select>

</mapper>