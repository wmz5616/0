<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.zemcho.ddql.mapper.order.ExchangeOrderAddressMapper">
    <sql id="fields">
        order_id,
        address_id,
        name,
        phone,
        region_id,
        address,
        location,
        create_time
    </sql>

    <insert id="insert">
        INSERT INTO `exchange_order_address`
        (<include refid="fields"/>)
        VALUES
        (
        #{data.orderId},
        #{data.addressId},
        #{data.name},
        #{data.phone},
        #{data.regionId},
        #{data.address},
        #{data.location},
        #{data.createTime}
        )
    </insert>

    <select id="selectByOrderId" resultType="com.zemcho.ddql.controller.wechat.index.vo.ExchangeOrderAddressVo">
        SELECT *
        FROM `exchange_order_address`
        WHERE order_id = #{orderId}
    </select>
</mapper>