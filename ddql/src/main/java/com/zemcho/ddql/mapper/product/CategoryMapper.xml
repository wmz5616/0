<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.zemcho.ddql.mapper.product.CategoryMapper">

    <insert id="insertBatch" keyProperty="id" useGeneratedKeys="true">
        INSERT INTO `category` (
        name,
        `sort`,
        create_time,
        update_time
        ) VALUES
        <foreach collection="data" item="item" separator=",">
            (
            #{item.name},
            #{item.sort},
            #{item.createTime},
            #{item.updateTime}
            )
        </foreach>
    </insert>

    <update id="updateBatch">
        <foreach collection="data" item="item" index="index" open="" close="" separator=";">
            update category
            SET
            name = #{item.name},
            `sort` = #{item.sort}
            WHERE id = #{item.id}
        </foreach>
    </update>

    <update id="updateSortAfterDelete">
        update category
        set `sort` = `sort` - 1
        where `sort` > #{deletedSort}
    </update>

    <select id="selectList" resultType="com.zemcho.ddql.entity.product.Category">
        SELECT *
        FROM `category`
        <where>
            <if test="param.searchId != null">
                AND id = #{param.searchId}
            </if>
            <if test="param.keyword != null and param.keyword != ''">
                AND `name` LIKE CONCAT('%',#{param.keyword},'%')
            </if>
        </where>
        order by sort
    </select>

    <select id="selectById" resultType="com.zemcho.ddql.entity.product.Category">
        select *
        from category
        <where>
            <if test="categoryId != null">
                and id = #{categoryId}
            </if>
        </where>
    </select>

    <select id="selectByProductIds" resultType="com.zemcho.ddql.controller.product.vo.CategoryVo">
        select
            c.*,
            pc.product_id
        from category c
        inner join product_category pc on c.id = pc.category_id
        <where>
            <if test="productIds != null and productIds.size() > 0">
                AND pc.product_id IN
                <foreach collection="productIds" item="item" open="(" separator="," close=")">
                    #{item}
                </foreach>
            </if>
        </where>
    </select>

</mapper>