/* pages/refundPolicy/refundPolicy.wxss */
.bc {
  position: relative;
  /* z-index: -999; */
  height: 100vh;
  background-color: rgba(249, 249, 249, 0.979);
}

.van-nav-bar {
  background-color: transparent !important;
  position: fixed !important;
  width: 100%;
}

.van-hairline--bottom:after {
  border: 0rpx !important;
}

.navLeft{
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background-color: rgba(249, 249, 249, 0.3);
  display: flex;
  justify-content: center;
  align-items: center;
}
.img{
  width: 20rpx;
  height: 35rpx;
}
.navText {
  font-size: 37rpx;
  color: #FFFFFF;
  font-weight: 500;
}
.text {
  position: absolute;
  width: 610rpx;
  background-color: #fff;
  top: 200rpx;
  left: 30rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  color: #333;
  font-weight: 400;
  text-indent: 2rem;
  padding: 20rpx 40rpx;
  line-height: 50rpx;
}

.btn {
  width: 100%;
  display: flex;
  justify-content: center;
  padding: 30rpx 0rpx 37rpx 0rpx;
  background-color: #fff;
  position: fixed;
  bottom: 0rpx;
  left: 0rpx;
}

.Btn {
  background-image: linear-gradient(192deg, #5DD5DE 0%, #4EACD3 84%);
  border-radius: 46rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 22rpx 251rpx;
  box-sizing: border-box;
  font-size: 32rpx;
  color: #FFFFFF;
  line-height: 48rpx;
  font-weight: 400;
}
