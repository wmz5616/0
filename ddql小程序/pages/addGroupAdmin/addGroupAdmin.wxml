<wxs module="utl" src="./addGroupAdmin.wxs"></wxs>
<view class="bc">
  <van-nav-bar bind:click-left="goBack">
    <image src="/assets/images/arrow-back.svg" class="img" mode="aspectFill" slot="left"></image>
    <text slot="title" class="navText">添加管理员</text>
  </van-nav-bar>
  <view class="rule box mlr">
    <view class="flex1">
      <view class="point"></view>
      <text class="rule_text">管理员可协助创建者管理团体，拥有编辑成员信息、充值购币等能力。</text>
    </view>
    <view class="flex1">
      <view class="point"></view>
      <text class="rule_text">只有创建者具备设置管理员、解散团体的能力。</text>
    </view>
    <view class="flex1">
      <view class="point"></view>
      <text class="rule_text">最多可设置3个管理员</text>
    </view>
  </view>
  <view class="mlr search">
    <van-search value="{{ keyword }}" bind:search="onSearch" bind:clear="onCancel" shape="round" background="#fff" placeholder="请输入姓名、昵称、手机号搜索" left-icon='' right-icon='search' placeholder-style="font-size: 30rpx;color:#CCC;" />
  </view>
  <view class="swiper">
    <!-- 移除 -->
    <view wx:for="{{teamUserLists}}" wx:key="id" class="box item">
      <view class="left flex" bind:tap="choseMember" data-userid="{{item.userId}}">
        <view class="l_left flex">
          <view class="radio {{utl.checkInclude(selectUserColumn,item.userId) && 'activeRadio'}}">
            <image wx:if="{{utl.checkInclude(selectUserColumn,item.userId)}}" src="/assets/images/chose.svg" mode="aspectFill" style="height: 20rpx;width: 20rpx;" />
          </view>
          <image src="{{item.avatar}}" style="height: 106rpx;width: 106rpx;border-radius: 50%;" mode="aspectFill" />
          <view class="f_l_r_top">
            <view class="flex ffff">
              <text class="tag">{{item.nickName}}</text>
              <text class="name">{{item.userName}}</text>
            </view>
            <text class="gray_tag">{{item.phone}}</text>
          </view>
        </view>
      </view>
    </view>
  </view>
  <view class="Btn">
    <view class="btn" bind:tap="add">确认添加</view>
  </view>
</view>