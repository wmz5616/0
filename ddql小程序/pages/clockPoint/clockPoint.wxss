.bc {
  height: 100vh;
  background-color: rgba(249, 249, 249, 0.979);
  position: relative;
  overflow: hidden;
}

.LRP30 {
  padding: 0 30rpx;
}

.flex {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.van-field__control {
  font-size: 30rpx !important;
  /* color: #CCCCCC !important; */
  font-weight: 400;
}

.van-icon--image {
  height: 45rpx !important;
  width: 43rpx !important;
}

.van-field {
  padding: 20rpx !important;
}

.swiper {
  width: 100%;
  height: calc(100vh - 368rpx);
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  overflow-y: auto;
}

.c_list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.c_lists {
  gap: 30rpx;
  color: #333;
  font-weight: 400;
  font-size: 20rpx;
  background: #FFFFFF;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
}

.c_l_right {
  padding: 24rpx 20rpx 16rpx 0rpx;
  height: 100%;
  box-sizing: border-box;
  flex-grow: 1;
}

.c_title {
  max-width: 200rpx;
  font-size: 30rpx;
  font-weight: 500;
  margin-bottom: 5rpx;
}

.tags {
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.tag_item {
  height: 36rpx;
  padding: 6rpx 10rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
  background: #F5F4F9;
  border-radius: 8rpx;
  font-size: 18rpx;
  color: #848484;
}

.c_bottom {
  gap: 10rpx;
}

.c_bottom:nth-child(3) {
  margin-bottom: 6rpx;
}

.location {
  width: 182rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
}

.btn {
  background: #E9FDFF;
  border: 1px solid rgba(4, 192, 217, 1);
  border-radius: 21rpx;
  color: #04C0D9;
  font-size: 20rpx;
  font-weight: 400;
  gap: 6rpx;
  height: 42rpx;
  width: 120rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.start {
  justify-content: flex-start;
  flex-wrap: wrap;
}

.Btn {
  height: 50rpx;
  padding: 6rpx 20rpx;
  background-image: linear-gradient(270deg, #5DD5DE 3%, #4EACD3 100%);
  display: flex;
  align-items: center;
  border-radius: 10rpx 8rpx 8rpx 10rpx;
  font-size: 26rpx;
  color: #FFFFFF;
  font-weight: 400;
}

.gray-btn {
  background: #A3A9AF;
}

.mask-wrapper {
  position: fixed;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.6);
  top: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999999;
}

.mask-wrapper .models .top {
  width: 88%;
  margin: 0 auto;
  position: relative;
  min-height: 1100rpx;
  background-color: #fff;
  padding: 25rpx;
  border-radius: 20rpx;
}
.concat-btn{
  background: #E9FDFF;
  border-radius: 21rpx;
  box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1), 0 6px 20px rgba(0, 0, 0, 0.1);
  color: #04C0D9;
  font-size: 20rpx;
  font-weight: 400;
  gap: 6rpx;
  height: 56rpx;
  width:160rpx !important;
  display: flex;
  justify-content: center;
  align-items: center;
  position: fixed;
  bottom:60rpx;
  z-index:99;
  right:30rpx;
  padding:0 !important;
}