.bc {
  height: 100vh;
  background-color: rgba(249, 249, 249, 0.979);
  position: relative;
  overflow: hidden;
}

.flex {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.p-title {
  height: 110rpx;
  width: 100%;
  padding: 30rpx 29rpx;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  box-sizing: border-box;
  border-bottom: 1rpx solid #E0DFE4;
  position: relative;
}

.p-close {
  height: 24rpx;
  width: 26rpx;
}

.p-connent {
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
  padding: 30rpx;
  gap: 30rpx;
}

.p_img {
  height: 137rpx;
  border: 1px solid rgba(245, 244, 249, 1);
  box-shadow: 0px 2px 10px 0px rgba(0, 0, 0, 0.1);
  border-radius: 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 20rpx;
  box-sizing: border-box;
}
.Btn {
  height: 92rpx;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 46px;
  box-sizing: border-box;
  font-size: 32rpx;
  font-weight: 400;
  gap: 10rpx;
  color: #fff;
}
.unAvtiveBtn {
  background: #FFFFFF;
  border: 1rpx solid #4EACD3;
  color: #04C0D9 !important;
}

.avtiveBtn {
  background-image: linear-gradient(192deg, #5DD5DE 0%, #4EACD3 84%);
}
.p-logo {
  height: 117rpx;
  width: 220rpx;
}

.p-code {
  height: 117rpx;
  width: 117rpx;
}

.p_btn {
  display: flex;
  gap: 30rpx;
  justify-content: center;
  align-items: center;
}

.swiper {
  width: 100%;
  height: calc(100vh - 344rpx);
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  overflow-y: auto;
}

.picker {
  width: 100%;
  height: 90rpx;
  box-sizing: border-box;
  padding: 0 100rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #fff;
}

.picker_item {
  height: 100%;
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.picker_title {
  font-size: 32rpx;
  color: #333333;
  line-height: 42rpx;
  font-weight: 500;
}

.base {
  height: 1rpx;
  width: 1rpx;
  border: 15rpx solid #A3A9AF;
}

.down {
  transform: translateY(25%);
  border-color: #A3A9AF transparent transparent transparent;
}

.up {
  transform: translateY(-25%);
  border-color: transparent transparent #A3A9AF transparent;
}

.warning {
  display: flex;
  flex-wrap: wrap;
  height: 75rpx;
  padding: 0rpx 25rpx;
  align-items: center;
  gap: 16rpx;
  background-color: #FFF9ED;
}

.warning_text {
  font-size: 30rpx;
  color: #FF6010;
  line-height: 42rpx;
  font-weight: 400;
}

.LRP30{
  padding: 0 30rpx;
}

.c_info {
  padding: 23rpx 0rpx 40rpx 0rpx;
  background: #FFFFFF;
  border-radius: 18px 18px 0px 0px;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  margin-bottom:30rpx;
}

.info_top {
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.i_t_left {
  display: flex;
  gap: 12rpx;
  justify-content: space-between;
  align-items: center;
}

.i_t_l_text {
  font-size: 42rpx;
  color: #04C0D9;
  font-weight: 500;
}

.i_t_right {
  height: 62rpx;
  width: 156rpx;
  border: 1px solid rgba(224, 223, 228, 1);
  font-size: 28rpx;
  color: #5D5C61;
  font-weight: 400;
  border-radius: 8px;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 13rpx;
}

.info_middle {
  border-bottom: 1rpx solid #DDD;
  border-top: 1rpx solid #DDD;
  padding: 30rpx 0rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.MLR30{
  margin: 0 30rpx;
}

.MT14{
  margin-top: 14rpx;
}

.i_m_text {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 30rpx;
  font-weight: 400;
}

.i_m_left {
  gap: 12rpx;
}

.gray_label {
  color: #848484;
}

.left-text {
  color: #333333;
}

.active_middle{
  font-size: 32rpx;
  color: #333333;
  font-weight:600;
}

.info_footer {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  color: #333;
  font-weight: 400;
  font-size: 30rpx;
}

.f_title {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 32rpx;
  font-weight: 500;
}

.max_left{
  width: 322rpx;
  text-align: left;
}

.max_middle{
  flex-grow: 1;
  text-align: center;
}

.max_last{
  flex-grow: 1;
  text-align: end;
}

.activeItem{
  height: 82rpx;
  background-color: #F3FFF8;
  padding: 0 30rpx;
  box-sizing: border-box;
}
.pickerTime{
  height: 110rpx;
  padding: 30rpx;
  box-sizing: border-box;
}
