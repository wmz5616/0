.bc {
  height: 100vh;
  background-color: #f9f9f9;
  position: relative;
  overflow: hidden;
}

.LRP30 {
  padding: 0 30rpx;
}

.flex {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.swiper {
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  overflow-y: auto;
  height: calc(100vh - 180rpx);
  position: relative;
}

.background {
  height: 640rpx;
  width: 100%;
}
.background1{
  height: 306rpx;
  width: 100%;
}
.top{
  width: calc(100vw - 60rpx);
  padding: 0rpx 30rpx;
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: absolute;
  top: 70rpx;
  left: 30rpx;
  color: #5D5C61;
}
.title {
  font-size: 36rpx;
  letter-spacing: 1.69rpx;
  font-weight: 400;
}
.title1{
  position: absolute;
  color: #FFFFFF;
  top: 70rpx;
  left: 50%;
  transform: translateX(-50%);
}
.gInfo {
  width: calc(100vw - 60rpx);
  position: absolute;
  top: 168rpx;
  left: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.gText {
  font-size: 32rpx;
  color: #333333;
  font-weight: 400;
  margin-bottom: 20rpx;
}

.codeImage {
  height: 311rpx;
  width: 312rpx;
}
.text{
  font-size: 32rpx;
  color: #04C0D9;
  letter-spacing: 1.5rpx;
  font-weight: 500;
  position: relative;
}
.activeText {
  color: #04C0D9;
}

.grayText{
  color: #5D5C61;
}

.grayText::before{
  content: '';
  width: 100%;
  height: 1rpx;
  background-color: #5D5C61;
  position: absolute;
  left: 0rpx;
  top: 50%;
}

.activeBtn {
  background-image: linear-gradient(270deg, #5DD5DE 3%, #4EACD3 100%);
  color: #FFFFFF;
}

.Btn1 {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0rpx 60rpx 30rpx 60rpx;
  box-sizing: border-box;
}

.btn1 {
  height: 92rpx;
  width: 100%;
  padding: 22rpx 0rpx;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 50rpx;
  font-size: 32rpx;
  line-height: 32rpx;
  font-weight: 400;
}

.couponList{
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  box-sizing: border-box;
}

.blue{
  color: #04C0D9 !important;
}
.blueBcakground{
  background-color: #04C0D9 !important;
}

.listText{
font-size: 32rpx;
color: #FFFFFF;
line-height: 50rpx;
font-weight: 500;
}
.selectItem{
  border: 1rpx solid #04C0D9;
}
.baseItem{
  border-radius: 16rpx;
  background-color: #fff ;
  padding: 30rpx;
  box-sizing: border-box;
}
.activeItem{
  background-image: linear-gradient(270deg, #5DD5DE 3%, #4EACD3 100%);
}
.pud46{
  padding-top: 46rpx;
  padding-bottom: 46rpx;
  border: 1rpx solid rgba(221,221,221,1);
}
.left{
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}
.gray{
  color: #CCCCCC;
}
.grayText1{
  position: relative;
}
.grayText1::before{
  content: '';
  width: 100%;
  height: 1rpx;
  background-color: #CCCCCC;
  position: absolute;
  left: 0rpx;
  top: 50%;
}

.f28{
  font-size: 28rpx;
font-weight: 400;
}

.right{
  height: 88rpx;
  width: 88rpx;
  border-radius: 50%;
  background-color: #fff;
  border: 1rpx #C9F8FC solid;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  align-items: center;
}

.iconImg{
  height: 44rpx;
  width: 44rpx;
}