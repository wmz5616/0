.bc {
  height: 100vh;
  background-color: #fff;
  position: relative;
  overflow: hidden;
}

.LRP30 {
  padding: 0 30rpx;
}

.flex {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tab .van-tabs__line {
  width: 150rpx !important;
}

.van-hairline--top-bottom:after {
  border-top: none !important;
}

.van-icon-search {
  font-size: 45rpx !important;
}

.header {
  margin: 10rpx 30rpx;
  box-sizing: border-box;
  height: 102rpx;
  padding: 0 30rpx;
  background: #FFFFFF;
  box-shadow: 0rpx 2rpx 10rpx 0rpx rgba(0, 0, 0, 0.1);
  border-radius: 12rpx;
}

.h_left {
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.h_right {
  display: flex;
  gap: 5rpx;
  align-items: center;
}

.coinText {
  font-size: 52rpx;
  color: #04C0D9;
  font-weight: 600;
  line-height: 73rpx;
}

.h_text {
  font-size: 32rpx;
  color: #333333;
  font-weight: 400;
  line-height: 45rpx;
}

.sheight {
  max-height: calc(100vh - 558rpx);
}

.ssheight {
  max-height: calc(100vh - 458rpx);
}

.swiper1 {
  width: 100%;
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
}

.g_item {
  height: 437rpx;
  width: 375rpx;
  padding: 30rpx 30rpx 40rpx 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.goodImages {
  width: 315rpx;
  height: 220rpx;
}

.goodInfo {
  display: flex;
  flex-direction: column;
  gap: 13rpx;
  width: 100%;
}

.goodTitle {
  font-size: 28rpx;
  color: #000000;
  line-height: 40rpx;
  font-weight: 400;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
}

.goodCoin {
  font-size: 30rpx;
  color: #04C0D9;
  font-weight: 500;
}

.goodExchanged {
  padding: 4rpx 23rpx 4rpx 20rpx;
  text-align: center;
  font-size: 22rpx;
  color: #464646;
  font-weight: 400;
  background: #F5F4F9;
  border: 1rpx solid rgba(224, 223, 228, 1);
  border-radius: 4rpx;
  box-sizing: border-box;
}

.consumption {
  position: relative;
  height: 90rpx;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  border-bottom: 1rpx solid #f1f1f1;
}

.Titem {
  width: 248rpx;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 32rpx;
  color: #333333;
  text-align: center;
  line-height: 42rpx;
  font-weight: 500;
}

.typeActive {
  color: #04C0D9;
}

.line {
  height: 4rpx;
  width: 248rpx;
  background-image: linear-gradient(270deg, #5DD5DE 3%, #4EACD3 100%);
  border-radius: 2rpx;
  position: absolute;
  bottom: 0rpx;
  left: 130rpx;
  transition: all 0.3s linear;
}

.scan {
  position: absolute;
  right: 30rpx;
  display: flex;
  align-items: center;
  flex-direction: column;
  gap: 10rpx;
  font-size: 20rpx;
  color: #333333;
  text-align: center;
  font-weight: 500;
}

.h362 {
  height: 372rpx;
}

.swipper {
  width: 100%;
  border-radius: 18rpx;
  position: relative;
  padding: 30rpx 30rpx 60rpx 30rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #f1f1f1;
  position: relative;
}

.Rflex {
  display: flex;
  gap: 60rpx;
}

.sItem {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.sImg {
  height: 220rpx;
  width: 315rpx;
  flex-shrink: 0;
  border-radius: 8rpx;
}

.sBottom {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  width: 100%;
}

.sTitle {
  font-size: 30rpx;
  color: #000000;
  line-height: 40rpx;
  font-weight: 400;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  flex: 1;
  padding-right: 10rpx;
}

.tis {
  font-size: 20rpx;
  color: #A3A9AF;
  font-weight: 400;
}

.dis {
  font-size: 22rpx;
  color: #04C0D9;
  font-weight: 400;
}


.dots-wrapper {
  display: flex;
  position: absolute;
  bottom: 30rpx;
  left: 50%;
  transform: translateX(-50%);
  height: 7rpx;
  gap: 9rpx;
}

.dot {
  height: 100%;
  background: #E0DFE4;
  transition: all 0.3s ease;
}

.normal-dot {
  width: 7rpx;
  border-radius: 50%;
  opacity: 0.6;
  transition: all 0.3s ease;
}

/* 激活态横线样式 */
.active-dot {
  width: 18rpx;
  border-radius: 4rpx;
  transition: all 0.3s ease;
}