.bc {
  height: 100vh;
  background-color: #f9f9f9;
  position: relative;
  overflow: hidden;
}

.LRP30 {
  padding: 0 30rpx;
}

.flex {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.swiper {
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  overflow-y: auto;
  height: calc(100vh - 302rpx);
}

.address {
  display: flex;
  flex-direction: column;
  padding: 30rpx;
  gap: 19rpx;
  box-sizing: border-box;
}

.h_top {
  display: flex;
  gap: 16rpx;
}

.title {
  font-size: 32rpx;
  color: #333333;
  line-height: 44rpx;
  font-weight: 500;
}

.fw400 {
  font-weight: 400;
}

.m_bottom {
  gap: 20rpx;
}

.goodImage {
  height: 168rpx;
  width: 202rpx;
  border-radius: 18rpx;
  flex-shrink: 0;
}

.m_b_right {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.m_b_right_top {
  gap: 48rpx;
  align-items: flex-start;
}

.label {
  line-height: 42rpx;
  font-weight: 400;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  text-overflow: ellipsis;
  word-break: break-all ;
}

.count {
  font-size: 30rpx;
  color: #333333;
  font-weight: 400;
  flex-shrink: 0;
}

.grayText{
  font-size: 30rpx;
  color: #5D5C61;
  font-weight: 400;
  flex-shrink: 0;
}

.m_b_right_bottom {
  text-align: right;
}

.heji {
  font-size: 26rpx;
  color: #333333;
  font-weight: 400;
}

.coin {
  font-size: 36rpx;
  color: #333333;
  text-align: center;
  line-height: 38rpx;
  font-weight: 500;
}

.gap30 {
  gap: 30rpx;
}

.orderNo {
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #DDD;
  box-sizing: border-box;
}

.process {
  display: flex;
  flex-direction: column;
  gap:80rpx;
  position: relative;
}

.line {
  position: absolute;
  left:8rpx;
  top: 0rpx;
  width: 1rpx;
  background-image: linear-gradient(180deg, #5DD5DE 0%, #4EACD3 84%);
}

.pItem {
  display: flex;
  gap: 20rpx;
}

.imgIcon {
  height: 78rpx;
  width: 78rpx;
  z-index: 1;
}

.pInfo {
  display: flex;
  flex-direction: column;
  gap: 3rpx;
}

.pTitle {
  font-size: 30rpx;
  color: #333333;
  font-weight: 400;
}

.grayTime {
  font-size: 24rpx;
  color: rgba(51, 51, 51, 0.60);
  font-weight: 400;
}

.Btn {
  display: flex;
  gap: 46rpx;
  align-items: center;
  justify-content: center;
  padding: 20rpx 0rpx;
  background-color: #FFFFFF;
}

.btn {
  height: 86rpx;
  padding: 0 82rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50rpx;
  font-size: 32rpx;
  line-height: 32rpx;
  font-weight: 400;
}

.Btn1 {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0rpx 60rpx 30rpx 60rpx;
  box-sizing: border-box;
}

.btn1 {
  height: 92rpx;
  width: 100%;
  padding: 22rpx 0rpx;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 50rpx;
  font-size: 32rpx;
  line-height: 32rpx;
  font-weight: 400;
  margin-top:10rpx;
}

.nomalBtn {
  color: #04C0D9;
  border: 1rpx solid #5DD5DE;
}

.activeBtn {
  background-image: linear-gradient(270deg, #5DD5DE 3%, #4EACD3 100%);
  color: #FFFFFF;
}

.van-dialog__header {
  padding-top: 46rpx !important;
  padding-bottom: 46rpx !important;
}

.d_content{
  margin-top: -16rpx;
}