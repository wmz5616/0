  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
  padding: 30rpx;
} */

.p_avtiveText {
  font-size: 30rpx;
  color: #04C0D9;
  font-weight: 400;
}

.p_text {
  font-size: 36rpx;
  padding-left: 33rpx;
  color: #333333;
  text-align: center;
  font-weight: 500;
}

.p_left {
  display: flex;
  gap: 30rpx;
}

.p_item {
  padding: 30rpx 0;
  border-bottom: 1rpx solid #D8D8D8;
  justify-content: center;
}

.p_item:last-child {
  border: none;
}