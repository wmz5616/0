.bc {
  height: 100vh;
  background-color: rgba(249, 249, 249, 0.979);
  position: relative;
  /* overflow: hidden; */
}

.LRP30 {
  padding: 0 30rpx;
}

.flex {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.swiper {
  width: 100%;
  /* height: calc(100vh - 382rpx); */
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  overflow-y: auto;
}

.header {
  padding: 14rpx 30rpx;
  box-sizing: border-box;
}

.h_left {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.imgIcon {
  height: 42rpx;
  width: 42rpx;
}

.coin {
  font-size: 52rpx;
  color: #04C0D9;
  font-weight: 500;
}

.text {
  font-size: 32rpx;
  color: #333333;
  font-weight: 400;
}

.h_right {
  display: flex;
  align-items: baseline;
  gap: 10rpx;
}

.rightIcon {
  height: 20rpx;
  width: 10rpx;
}


.m_top {
  padding: 30rpx 60rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.same {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.line {
  height: 42rpx;
  width: 8rpx;
  background: #F1F1F1;
}

.grayText {
  font-size: 30rpx;
  color: #666666;
  text-align: center;
  font-weight: 400;
}

.down {
  transform: rotate(90deg);
}

.m_bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
  position: relative;
  border-top: 1rpx solid #F1F1F1;
  box-sizing: border-box;
  padding: 0rpx 10rpx;
}

.item {
  height: 98rpx;
  width: 164rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.bLine {
  position: absolute;
  width: 164rpx;
  height: 4rpx;
  left: 10rpx;
  bottom: 0rpx;
  transition: all 0.3s linear;
  background-image: linear-gradient(90deg, #A4F8DD 0%, #74C4FF 100%);
  border-radius: 2rpx;
}

.active {
  color: #1CD2E3;
}

.list {
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  background: #fff;
}

.qy {
  background: #F3FFF8;
}

.py {
  background: #F2FDFF;
}

.zf {
  background: #EFF3FF;
}

.grayTime {
  font-size: 24rpx;
  color: #999999;
  line-height: 28rpx;
  font-weight: 400;
}

.text1 {
  font-size: 30rpx;
  color: #333333;
  line-height: 28rpx;
  font-weight: 400;
}

