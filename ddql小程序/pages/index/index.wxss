.bc {
  height: 100vh;
  background-color: rgba(249, 249, 249, 0.979);
  position: relative;
  overflow-x: hidden;
}

.swipper {
  padding-bottom: 30rpx;
}

.backgroundImage {
  width: 100%;
  margin-bottom: 45rpx;
}

.img {
  height: 52rpx;
  width: 153rpx;
}

.navText {
  font-size: 37rpx;
  color: #FFFFFF;
  letter-spacing: 0;
  font-weight: 500;
}

.van-nav-bar {
  background-color: transparent !important;
  position: absolute !important;
  width: 100%;
}

.van-hairline--bottom:after {
  border: 0rpx !important;
}

.header {
  position: absolute;
  top: 200rpx;
  height: 312rpx;
  width: 100%;
  padding: 0rpx 30rpx 30rpx 30rpx;
  box-sizing: border-box;
}

.swiper-image {
  width: 100%;
  height: 100%;
  border-radius: 18rpx;
}

.dots-wrapper {
  display: flex;
  position: absolute;
  bottom: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  height: 7rpx;
  gap: 9rpx;
}

.dot {
  height: 100%;
  background-color: #fff;
  transition: all 0.3s ease;
}

.normal-dot {
  width: 7rpx;
  border-radius: 50%;
  opacity: 0.6;
  transition: all 0.3s ease;
}

/* 激活态横线样式 */
.active-dot {
  width: 18rpx;
  border-radius: 4rpx;
  transition: all 0.3s ease;
}

.bottom {
  width: 690rpx;
  box-sizing: border-box;
  margin: 0rpx 30rpx;
  background: #FFFFFF;
  box-shadow: 0px 2px 10px 0px rgba(0, 0, 0, 0.21);
  border-radius: 18px;
}

.guanggao {
  display: flex;
  background: #FFF9ED;
  width: 100%;
  height: 75rpx;
  align-items: center;
  border-radius: 18rpx 18rpx 0rpx 0rpx;
  justify-content: space-between;
}

.left {
  display: flex;
  margin-right: 16rpx;
}

.laba {
  width: 38rpx;
  height: 38rpx;
  margin-left: 40rpx;
}

.swiperText {
  font-size: 30rpx;
  color: #FF6010;
  font-weight: 400;
}

.more {
  font-size: 30rpx;
  color: #FF6010;
  font-weight: 400;
  margin-right: 40rpx;
  margin-left: 16rpx;
}

.b_middle {
  padding: 30rpx;
  position: relative;
  color: #fff;
}

.top_coin {
  display: flex;
  flex-direction: column;
  gap: 26rpx;
}

.coin {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 84rpx;
  width: 100%;
}

.l_coin {
  display: flex;
  gap: 10rpx;
  height: 100%;
  position: relative;
  align-items: center;
  padding-left: 29rpx;
}

.coin-image {
  height: 84rpx;
  width: 84rpx;
  position: absolute;
  left: 0;
  top: 0;
}

.coin-content {
  height: 64rpx;
  border-radius: 48px;
  display: flex;
  align-items: center;
  padding: 0rpx 20rpx 0rpx 65rpx;
  gap: 10rpx;
}

.blueImage {
  background-image: linear-gradient(90deg, #A6F8FF 0%, #3AABCB 100%);
}

.orangeImage {
  background-image: linear-gradient(90deg, #FFCC71 0%, #F78226 100%);
}

.count {
  font-size: 30rpx;
  line-height: 32px;
  font-weight: 500;
}

.c_text {
  font-size: 20rpx;
  font-weight: 400;
}

.rightArrow {
  height: 20rpx;
  width: 11rpx;
}

.info {
  position: relative;
}

.toast::before {
  content: '';
  display: block;
  position: absolute;
  left: 60rpx;
  bottom: -34rpx;
  width: 1rpx;
  border: 18rpx solid #fff;
  z-index: 2;
  border-color: #fff transparent transparent transparent;
}

.toast {
  /* max-width: 337rpx; */
  background: #FFFFFF;
  box-shadow: 0px 5px 32px 0px rgba(51, 51, 51, 0.25);
  padding: 11rpx 19rpx;
  position: absolute;
  bottom: 60rpx;
  left: -60rpx;
  z-index: 1;
  border-radius: 18rpx;
  box-sizing: border-box;
}

.toast_text {
  max-width: 318rpx;
  word-break: break-all;
  font-size: 30rpx;
  color: #333333;
  font-weight: 400;
}

.warning {
  height: 36rpx;
  width: 36rpx;
}

.tag {
  height: 50rpx;
  display: flex;
  align-items: center;
  padding: 0rpx 24.5rpx;
  background-image: linear-gradient(270deg, #5DD5DE 3%, #4EACD3 100%);
  border-radius: 10px 0px 0px 10px;
  transform: translateX(36rpx);
}

.tag::after {
  content: '';
  display: block;
  position: absolute;
  right: 1rpx;
  width: 1rpx;
  border: 5rpx solid #5D5c61;
  border-color: transparent #5D5c61 transparent transparent;
  transform: rotate(-45deg);
  top: -5rpx;
}

.tag_text {
  font-size: 30rpx;
  text-align: center;
  font-weight: 400;
}

.line {
  height: 1rpx;
  border-bottom: 1rpx solid #D8D8D8;
  margin-top: 20rpx;
}

.bottom_coin {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14rpx;
}

.grayText {
  font-size: 26rpx;
  color: #999999;
  font-weight: 400;
}

.btn {
  height: 92rpx;
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 46px;
  box-sizing: border-box;
  font-size: 32rpx;
  font-weight: 400;
  gap: 10rpx;
  color: #fff;
  margin-bottom: 10rpx;
}

.avtiveBtn {
  background-image: linear-gradient(192deg, #5DD5DE 0%, #4EACD3 84%);
}

.unAvtiveBtn {
  background: #FFFFFF;
  background-image: linear-gradient(192deg, #5DD5DE 0%, #4EACD3 84%);
  color: #fff !important;
}

.grayBtn {
  background: #A3A9AF;
}

.b_footer {
  padding: 30rpx;
  box-sizing: border-box;
}

.location {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 42rpx;
}

.l_left {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: #333333;
  font-weight: 400;
}

.l_right {
  height: 62rpx;
  width: 156rpx;
  border: 1px solid rgba(224, 223, 228, 1);
  font-size: 28rpx;
  color: #5D5C61;
  font-weight: 400;
  border-radius: 8px;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 13rpx;
}

.time {
  display: flex;
  justify-content: center;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
}

.time_count {
  font-size: 72rpx;
  color: #0D0E10;
  font-weight: 500;
}

.time_text {
  font-size: 30rpx;
  color: #A3A9AF;
  font-weight: 400;
}

.f_content {
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 10rpx;
}

.f_title {
  font-size: 30rpx;
  color: #0D0E10;
  font-weight: 400;
}

.f_c_middle {
  display: flex;
  align-items: center;
  gap: 11rpx;
  position: relative;
}

.progress_step {
  height: 18rpx;
  flex: 0 0 378rpx;
  border-radius: 10px;
}

.activeProgress {
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
}

.gray_progress {
  background-color: #EBEBEB;
  margin-right: 21rpx;
}

.blue_progress {
  background-image: linear-gradient(180deg, #0AE1EE 0%, #04C0D9 100%);
}

.green_progress {
  background-image: linear-gradient(180deg, #0AEE74 1%, #04D962 100%);
}

.yellow_progress {
  background-image: linear-gradient(180deg, #EEEA0A 0%, #D99504 99%);
}

.present {
  font-size: 26rpx;
  color: #0D0E10;
  font-weight: 400;
  flex-shrink: 0;
}

.presentText {
  font-size: 20rpx;
  color: #5D5C61;
  font-weight: 400;
}

.p-title {
  height: 110rpx;
  width: 100%;
  padding: 30rpx 29rpx;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  box-sizing: border-box;
  border-bottom: 1rpx solid #E0DFE4;
  position: relative;
}

.p-text {
  font-size: 36rpx;
  color: #333333;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-weight: 500;
}

.p-close {
  height: 24rpx;
  width: 26rpx;
}

.p-connent {
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
  padding: 30rpx;
  gap: 30rpx;
}

.p_img {
  height: 137rpx;
  border: 1px solid rgba(245, 244, 249, 1);
  box-shadow: 0px 2px 10px 0px rgba(0, 0, 0, 0.1);
  border-radius: 18rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 20rpx;
  box-sizing: border-box;
}

.p-logo {
  height: 117rpx;
  width: 220rpx;
}

.p-code {
  height: 117rpx;
  width: 117rpx;
}

.p_btn {
  display: flex;
  gap: 30rpx;
  justify-content: center;
  align-items: center;
}

.Btn {
  height: 92rpx;
  width: 330rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 46rpx;
  color: #fff;
  gap: 10rpx;
}

.pop {
  overflow: hidden;
}


.mask-wrapper {
  position: fixed;
  width: 100%;
  height: 100%;
  background-color: rgba(0, 0, 0, 0.6);
  top: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999999;
}

.mask-wrapper .models .top {
  width: 88%;
  margin: 0 auto;
  position: relative;
  min-height: 1100rpx;
  background-color: #fff;
  padding: 25rpx;
  border-radius: 20rpx;
}

.c_list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  padding-top: 35rpx;
  max-height: 980rpx;
  overflow-y: auto
}

.c_lists {
  gap: 30rpx;
  color: #333;
  font-weight: 400;
  font-size: 20rpx;
  background: #FFFFFF;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
}

.c_l_right {
  padding: 24rpx 20rpx 16rpx 0rpx;
  height: 100%;
  box-sizing: border-box;
  flex-grow: 1;
}

.c_title {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 5rpx;
}

.start {
  justify-content: flex-start !important;
  flex-wrap: wrap;
}

.locations {
  width: 182rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
}

.btns {
  background: #E9FDFF;
  border: 1px solid rgba(4, 192, 217, 1);
  border-radius: 21rpx;
  color: #04C0D9;
  font-size: 20rpx;
  font-weight: 400;
  gap: 6rpx;
  height: 42rpx;
  width: 102rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.flex {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.c_bottom {
  gap: 10rpx;
  line-height: 2;
}

.disable-btn {
  background: #A3A9AF !important;
  border: none;
  color: #fff !important;
}

.showLocation {
  position: fixed;
  bottom: 20rpx;
  width: 100%;
  background-color: rgba(0, 0, 0, 0.7);
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 15rpx 30rpx;
  box-sizing: border-box;
  border-radius: 15rpx;
}

.s_top {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.s_t_top {
  font-size: 24rpx;
  color: #fff;
  font-weight: 500;
}

.s_t_bottom {
  font-size: 20rpx;
  color: #b8b7b7;
}

.s_bottom {
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.nopositonbtn {
  height: 40rpx;
  background-image: linear-gradient(90deg, #A6F8FF 0%, #3AABCB 100%);
  display: flex;
  font-size: 20rpx;
  padding: 5rpx 18rpx;
  align-items: center;
  color: #fff;
  border-radius: 50rpx;
}

.overlay {
  height: 100%;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.oBox {
  /* height: 771rpx; */
  width: 690rpx;
  background: #FFFFFF;
  border-radius: 12px;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  padding: 30rpx 0rpx;
  box-sizing: border-box;
  position: relative;
}

.obHeader {
  display: flex;
  justify-content: center;
  align-items: center;
}

.obTitle {
  font-size: 36rpx;
  color: #333333;
  text-align: center;
  line-height: 48rpx;
  font-weight: 400;
}

.closeImg {
  position: absolute;
  padding: 30rpx;
  box-sizing: border-box;
