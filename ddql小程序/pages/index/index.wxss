}

.auditItem {
  display: flex;
  gap: 4rpx;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #E5E5E5;
}

.Cflex {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.Rflex {
  display: flex;
  gap: 36rpx;
  align-items: center;
}

.auditItem:last-child {
  border: none !important;
  padding: 0rpx !important;
}

.obText {
  font-size: 28rpx;
  color: #666666;
  text-align: justify;
  font-weight: 400;
}

.obTime {
  font-size: 24rpx;
  color: #666666;
  font-weight: 400;
}

.hasRead {
  background-image: linear-gradient(226deg, #5DD5DE 0%, #4EACD3 84%);
  border-radius: 50px;
  height: 78rpx;
  width: 292rpx;
  font-size: 32rpx;
  color: #FFFFFF;
  text-align: center;
  line-height: 32rpx;
  font-weight: 400;
  display: flex;
  justify-content: center;
  align-items: center;
}

.obBottom{
  padding: 0 30rpx;
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
}

.round{
  height: 36rpx;
  width: 36rpx;
  background: #FFF;
  border: 2rpx solid #cccccc;
  border-radius: 8rpx;
}

.tis {
  font-size: 24rpx;
  color: #666666;
  text-align: center;
  font-weight: 400;
}