      <!-- 确认登录按钮 -->
      <!-- <view class="login" bindtap="submit">确认登录</view> -->
      <!-- 手机快捷登录按钮 -->
      <view wx:if="{{(!isSuccess || c) && phone}}" class="login" bindtap="quickLogin">手机快捷登录</view>
      <button wx:if="{{isSuccess && !phone}}" class="bind-btn" open-type="getPhoneNumber" bindgetphonenumber="getThePhoneNumber">一键授权绑定手机</button>
      <view data-type="cancel" class="grayBtn" bindtap="goBack">取消登录</view>
    </view>
  </view>
