      <text slot="title" class="navText">登录</text>
    </van-nav-bar>
    <image src="/assets/images/backgroundImage.png" mode="aspectFill" class="backgroundImage"></image>
  <!-- 顶部图片和Logo -->
  <view class="header">
    <image src="{{src}}" mode="aspectFill" class="background-image"></image>
    <!-- <image src="/assets/images/logo.png" mode="aspectFit" class="logo"></image>  -->
  </view>

  <!-- 表单区域 -->
  <view class="content">
    <view class="form-wrapper">
