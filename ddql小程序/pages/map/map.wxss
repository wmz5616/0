/* pages/map/map.wxss */
.bc {
  overflow: hidden;
  background-color: #f9f9f9;
  height: 100vh;
}

.ssearch{
  position: relative;
}

.ssearch .van-cell {
  padding: 20rpx 20rpx 20rpx 0 !important;
}

.ssearch .van-field__icon-container {
  display: flex;
  align-items: center;
  justify-content: center;
}

.swiper {
  padding: 30rpx;
  box-sizing: border-box;
  width: 100%;
  overflow-y: scroll;
}

.map {
  height: 905rpx;
  width: 690rpx;
  border-radius: 18rpx;
}

.content {
  height: 100rpx;
  width: 100rpx;
  background-color: #f9f9f9;
}

.Btn {
  padding: 0rpx 30rpx 30rpx 30rpx;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
}

.btn {
  height: 92rpx;
  width: 630rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-image: linear-gradient(167deg, #8153FC 0%, #6070FB 82%);
  border-radius: 46rpx;
  font-size: 32rpx;
  color: #FFFFFF;
  text-align: center;
  line-height: 48rpx;
  font-weight: 400;
}

.box{
  position: absolute;
}