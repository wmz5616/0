/* pages/orderDetail/orderDetail.wxss */
.bc {
  overflow: hidden;
  background-color: #f9f9f9;
}

.swiper {
  height: calc(100vh - 180rpx);
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  gap: 30rpx;
  flex-direction: column;
}

.shadow {
  background: #FFFFFF;
  border-radius: 18rpx;
  padding: 30rpx;
  box-sizing: border-box;
}

.header {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.flex {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.status {
  font-size: 32rpx;
  color: #0F1741;
  line-height: 51rpx;
  font-weight: 500;
}

.red {
  color: #E62E3D;
}
.green{
  color: #27b43e;
}

.link {
  padding-bottom: 30rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #DDDDDD;
}

.title {
  font-size: 32rpx;
  color: #333333;
  line-height: 51rpx;
  font-weight: 500;
}

.info {
  display: flex;
  flex-direction: column;
  gap: 17rpx;
}

.text {
  font-size: 30rpx;
  color: #333333;
  text-align: right;
  font-weight: 400;
}

.c666 {
  font-size: 30rpx;
  color: #666666;
  font-weight: 400;
}

.grayText {
  font-size: 30rpx;
  color: #999999;
  font-weight: 400;
}

.copy {
  background: #F8F8F8 !important;
  border: 1rpx solid rgba(224, 223, 228, 1) !important;
  border-radius: 20rpx !important;
  height: 40rpx !important;
  width: 84rpx !important;
  font-size: 22rpx !important;
  padding: 0rpx !important;
  color: #5D5C61 !important;
  line-height: 36rpx !important;
  font-weight: 400;
}

.grayTitle {
  font-size: 32rpx;
  color: #999999;
  line-height: 50rpx;
  font-weight: 400;
}

.price {
  font-size: 32rpx;
  color: #333333;
  text-align: right;
  line-height: 50rpx;
  font-weight: 400;
}

.last {
  display: flex;
  justify-content: flex-end;
  align-items: center;
}

.order {
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.activeText {
  font-size: 42rpx;
  color: #04C0D9;
  text-align: right;
  line-height: 42rpx;
  font-weight: 500;
}

.gap10 {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.f28{
  font-size: 28rpx;
}