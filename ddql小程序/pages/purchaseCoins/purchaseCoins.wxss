.bc {
  height: 100vh;
  background-color: rgba(249, 249, 249, 0.979);
  position: relative;
  overflow: hidden;
}

.LRP30 {
  padding: 0 30rpx;
}

.flex {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.swiper {
  width: 100%;
  height: calc(100vh - 308rpx);
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30rpx;
  overflow-y: auto;
}

.Btn1{
  padding: 0 60rpx 40rpx 60rpx;
  box-sizing: border-box;
}

.top {
  display: flex;
  flex-direction: column;
  gap: 11rpx;
}

.t_top {
  align-items: flex-start;
}

.title {
  font-size: 32rpx;
  color: #333333;
  font-weight: 400;
}

.Btn {
  background-image: linear-gradient(270deg, #5DD5DE 3%, #4EACD3 100%);
  height: 64rpx;
  border-radius: 8rpx;
  font-size: 32rpx;
  color: #FFFFFF;
  font-weight: 400;
  padding: 10rpx 20rpx;
  box-sizing: border-box;
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.t_bottom {
  gap: 20rpx;
}

.t_b_left {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #5D5C61;
  font-weight: 400;
}

.coin {
  color: #333333;
  font-size: 36rpx;
  font-weight: 500;
  margin-left: 10rpx;
}

.nomal_text {
  margin-right: 10rpx;
}

.t_b_right {
  gap: 10rpx;
}

.t_bottoms {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  gap: 10rpx;
}


.middle {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.m_top {
  display: flex;
  gap: 16rpx;
  align-items: center;
}

.m_bottom {
  display: flex;
  flex-wrap: wrap;
  gap: 30rpx;
}

.coin_box {
  width: 300rpx;
  height: 150rpx;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
  justify-content: center;
  align-items: center;
  background: #F9F9F9;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: 400;
  position: relative;
}

.activeCoin {
  color: #04C0D9 !important;
}

.selectImage {
  width: 300rpx;
  height: 150rpx;
  position: absolute;
  left: 0;
  top: 0;
  z-index: 1;
}

.c_b_top {
  color: #333;
  font-size: 24rpx;
  z-index: 1;
}

.c_b_coin {
  font-size: 48rpx;
  font-weight: 500;
}

.c_b_bottom {
  color: #A3A9AF;
}

.zdy {
  font-size: 36rpx;
  color: #333333;
  font-weight: 400;
  display: flex;
  justify-content: center;
  align-items: flex-end;
}

.inpt{
  width: 50%;
  font-size: 48rpx;
}

.bottom {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.list {
  display: flex;
  flex-direction: column;
  font-size: 28rpx;
  color: #848484;
  font-weight: 400;
}

.btn {
  background-image: linear-gradient(192deg, #5DD5DE 0%, #4EACD3 84%);
  border-radius: 46rpx;
  height: 92rpx;
  width: 630rpx;
  justify-content: center;
  font-size: 32rpx;
  color: #FFFFFF;
}

.p_connent {
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
  padding: 30rpx;
}

.p_avtiveText {
  font-size: 30rpx;
  color: #04C0D9;
  font-weight: 400;
}

.p_item {
  padding: 30rpx 0;
  border-bottom: 1rpx solid #D8D8D8;
}

.p_item:last-child {
  border: none;
}

.circle {
  height: 28rpx;
  width: 28rpx;
  border-radius: 50%;
}

.p_i_text {
  font-size: 30rpx;
  color: #333333;
  font-weight: 400;
}

.green {
  background-color: #00A647;
}

.orange {
  background-color: #F36A00;
}

.blue {
  background-color: #04C0D9;
}


.pTab .van-picker__cancel,.pTab .van-picker__confirm{
  font-size: 30rpx;
  color: #04C0D9;
  font-weight: 400;
}

.pTab .van-picker__title{
  font-size: 36rpx;
  color: #333333;
  text-align: center;
  font-weight: 500;
}