/* pages/refundPolicy/refundPolicy.wxss */
.bc {
  position: relative;
  height: 100vh;
  background-color: rgba(249, 249, 249, 0.979);
}

.van-nav-bar {
  background-color: transparent !important;
  position: fixed !important;
  width: 100%;
}

.van-hairline--bottom:after {
  border: 0rpx !important;
}

.navLeft {
  width: 50rpx;
  height: 50rpx;
  border-radius: 50%;
  background-color: rgba(249, 249, 249, 0.3);
  display: flex;
  justify-content: center;
  align-items: center;
}

.img {
  width: 20rpx;
  height: 35rpx;
}

.navText {
  font-size: 37rpx;
  color: #FFFFFF;
  font-weight: 500;
}

.text {
  position: absolute;
  width: 610rpx;
  height: 1157rpx;
  background-color: #fff;
  top: 200rpx;
  left: 30rpx;
  border-radius: 16rpx;
  font-size: 32rpx;
  color: #333;
  font-weight: 400;
  text-indent: 2rem;
  padding: 20rpx 40rpx;
  line-height: 50rpx;
  box-shadow: 0px 6px 20px 0px rgba(0, 0, 0, 0.13);
}