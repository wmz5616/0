/* pages/scanToPay/scanToPay.wxss */
.bc {
  height: 100vh;
  background-color: rgba(249, 249, 249, 0.979);
  position: relative;
  overflow: hidden;
}

.Rflex {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.Cflex {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
}

.boxShadow {
  background: #FFFFFF;
  border-radius: 12rpx;
}

.swiper {
  width: 100%;
  height: calc(100vh - 298rpx);
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  overflow-y: auto;
}

.g20 {
  gap: 20rpx;
}

.text {
  font-size: 30rpx;
  color: #333333;
  letter-spacing: 0;
  font-weight: 400;
}

.header {
  padding: 24rpx 30rpx;
}

.samllBtn {
  background-image: linear-gradient(270deg, #5DD5DE 3%, #4EACD3 100%);
  border-radius: 29rpx;
  font-size: 30rpx;
  color: #FFFFFF;
  letter-spacing: 0;
  text-align: center;
  font-weight: 400;
  padding: 8rpx 24rpx;
  width: fit-content;
}

.input {
  width: 180rpx;
  border-bottom: 1rpx solid #333;
  font-size: 30rpx;
  color: #FB9B00;
  letter-spacing: 0;
  font-weight: 400;
  height: 100%;
  padding: 10rpx 20rpx;
  box-sizing: border-box;
}

.grayText {
  font-size: 28rpx;
  color: #848484;
  text-align: center;
  font-weight: 400;
}

.empty {
  display: flex;
  flex-direction: column;
  padding: 30rpx;
  box-sizing: border-box;
  gap: 30rpx;
  align-items: center;
  width: 100%;
}

.mHeader {
  display: flex;
  gap: 10rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #F4F4F4;
  padding: 30rpx 30rpx 20rpx 30rpx;
}

.p30 {
  padding: 30rpx;
  box-sizing: border-box;
}

.Acolor {
  font-size: 36rpx;
  color: #04C0D9;
  letter-spacing: 0;
  line-height: 46rpx;
  font-weight: 500;
}

.coin {
  font-size: 32rpx;
  color: #333333;
  letter-spacing: 0;
  font-weight: 400;
}

.mMiddle {
  display: flex;
  flex-direction: column;
  gap: 17rpx;
}

.price {
  font-size: 56rpx;
  color: #333333;
  letter-spacing: 0;
  font-weight: 500;
}

.btn {
  width: 100%;
  padding-bottom: 30rpx;
  display: flex;
  justify-content: center;
}

.Btn {
  width: 630rpx;
  height: 92rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 32rpx;
  color: #FFFFFF;
  letter-spacing: 0;
  text-align: center;
  line-height: 48rpx;
  font-weight: 400;
  background-image: linear-gradient(270deg, #5DD5DE 3%, #4EACD3 100%);
  border-radius: 58rpx;
}

.circle {
  height: 36rpx;
  width: 36rpx;
  display: flex;
  align-items: baseline;
  justify-content: center;
  background: #CCCCCC;
  color: #FFFFFF;
  border-radius: 50%;
  font-size: 24rpx;
}

.Oinput {
  font-size: 56rpx;
  color: #333333;
  letter-spacing: 0;
  font-weight: 500;
  height: 78rpx;
}

.g30{
  gap: 30rpx;
}