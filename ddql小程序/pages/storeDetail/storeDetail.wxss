.bc {
  height: 100vh;
  background-color: rgba(249, 249, 249, 0.979);
  position: relative;
  overflow: hidden;
}

.flex {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.swiperr {
  width: 100%;
  height: calc(100vh - 180rpx);
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  overflow-y: auto;
}

.header {
  position: relative;
  height: 312rpx;
  width: 100%;
  box-sizing: border-box;
}

.swiper-image {
  width: 100%;
  height: 100%;
  border-radius: 18rpx;
}

.dots-wrapper {
  display: flex;
  position: absolute;
  bottom: 60rpx;
  left: 50%;
  transform: translateX(-50%);
  height: 7rpx;
  gap: 9rpx;
}

.dot {
  height: 100%;
  background-color: #fff;
  transition: all 0.3s ease;
}

.normal-dot {
  width: 7rpx;
  border-radius: 50%;
  opacity: 0.6;
  transition: all 0.3s ease;
}

/* 激活态横线样式 */
.active-dot {
  width: 18rpx;
  border-radius: 4rpx;
  transition: all 0.3s ease;
}

.l_right {
  height: 62rpx;
  width: 156rpx;
  border: 1px solid rgba(224, 223, 228, 1);
  font-size: 28rpx;
  color: #5D5C61;
  font-weight: 400;
  border-radius: 8px;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 13rpx;
}

.location1 {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  border-radius: 18rpx;
}

.l_left {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  align-items: flex-start;
}

.l_text {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  color: #333333;
  text-align: center;
  font-weight: 400;
}

.title {
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
}

.middle {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  padding: 30rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  border-radius: 18rpx;
}

.m_bottom {
  font-size: 30rpx;
  color: #333333;
  font-weight: 400;
  display: flex;
  gap: 52rpx;
}

.introduce {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
  padding: 30rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  border-radius: 18rpx;
  color: #333333;
}

.i_content {
  text-indent: 2em;
  font-size: 26rpx;
  line-height: 42rpx;
  font-weight: 400;
}

.c_list {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.c_lists {
  gap: 30rpx;
  color: #333;
  font-weight: 400;
  font-size: 20rpx;
  background: #FFFFFF;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
}

.c_l_right {
  padding: 24rpx 20rpx 16rpx 0rpx;
  height: 100%;
  box-sizing: border-box;
  flex-grow: 1;
}

.c_title {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 5rpx;
}

.tags {
  gap: 10rpx;
  margin-bottom: 16rpx;
}

.tag_item {
  height: 36rpx;
  padding: 6rpx 10rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
  background: #F5F4F9;
  border-radius: 8rpx;
  font-size: 18rpx;
  color: #848484;
}

.c_bottom {
  gap: 10rpx;
}

.location {
  width: 182rpx;
  white-space: nowrap;
  text-overflow: ellipsis;
  overflow: hidden;
}

.btn {
  background: #E9FDFF;
  border: 1px solid rgba(4, 192, 217, 1);
  border-radius: 21rpx;
  color: #04C0D9;
  font-size: 20rpx;
  font-weight: 400;
  gap: 6rpx;
  height: 42rpx;
  width: 102rpx;
  display: flex;
  justify-content: center;
  align-items: center;
}

.start {
  justify-content: flex-start;
  flex-wrap: wrap;
}

.p-title {
  height: 110rpx;
  width: 100%;
  padding: 30rpx 29rpx;
  display: flex;
  justify-content: flex-end;
  align-items: center;
  box-sizing: border-box;
  border-bottom: 1rpx solid #E0DFE4;
  position: relative;
}

.p-text {
  font-size: 36rpx;
  color: #333333;
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  font-weight: 500;
}

.p-close {
  height: 24rpx;
  width: 26rpx;
}

.p-connent {
  display: flex;
  flex-direction: column;
  justify-content: center;
  box-sizing: border-box;
  padding: 30rpx;
  gap: 30rpx;
}
.p_btn {
  display: flex;
  gap: 30rpx;
  justify-content: center;
  align-items: center;
}

.Btn {
  height: 92rpx;
  width: 330rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 46rpx;
  color: #fff;
  gap: 10rpx;
}

.avtiveBtn {
  background-image: linear-gradient(192deg, #5DD5DE 0%, #4EACD3 84%);
}

.unAvtiveBtn {
  background: #FFFFFF;
  border: 1rpx solid #4EACD3;
  color: #04C0D9 !important;
}
