/* pages/storeManage/storeManage.wxss */
.bc {
  height: 100vh;
  overflow: hidden;
  background-color: #f8f8f8;
}

.swiper {
  height: calc(100vh - 300rpx);
}

.h338 {
  height: calc(100vh - 338rpx);
}

.shadow {
  background: #FFFFFF;
  box-shadow: 0rpx 2rpx 10rpx 0rpx rgba(0, 0, 0, 0.05);
  border-radius: 18rpx;
}

.item{
  margin: 30rpx 30rpx 0rpx 30rpx;

}

.left {
  height: 166rpx;
  width: 690rpx;
  background-color: #FFFFFF;
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.l_left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.avatar {
  height: 106rpx;
  width: 106rpx;
  border-radius: 50%;
}

.shopName {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
}

.nomal {
  font-size: 30rpx;
  color: #999999;
  font-weight: 400;
  margin-left: 4rpx;
}

.success {
  color: #04C0D9;
}

.red {
  color: #E62E3D;
}

.orange {
  color: #FB9B00;
}


.baseSwipe {
  height: 100%;
  width: 120rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 30rpx;
  color: #FFFFFF;
  text-align: center;
  font-weight: 400;
}

.delete {
  background: #E62E3D;
  border-radius: 0rpx 18rpx 18rpx 0rpx;
}

.slotRight {
  height: 100%;
  width: 120rpx;
}

.Btn {
  padding: 0rpx 30rpx 30rpx 30rpx;
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.isIOS {
  padding-bottom: env(safe-area-inset-bottom);
}

.btn {
  height: 90rpx;
  width: 330rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #FFFFFF;
  text-align: center;
  font-weight: 400;
  background-image: linear-gradient(195deg, #5DD5DE 0%, #4EACD3 84%);
  border-radius: 60rpx;
}

.activeBtn {
  border: 1rpx solid #5DD5DE;
  color: #04C0D9;
  background-image: none;
  background-color: #FFFFFF;
  box-sizing: border-box;
  position: relative;
}

.badge {
  position: absolute;
  right: 0rpx;
  top: -10rpx;
  height: 32rpx;
  width: 32rpx;
  background: #E62E3D;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 20rpx;
  color: #FFFFFF;
  text-align: center;
  line-height: 20rpx;
  font-weight: 400;
  border-radius: 50%;
}