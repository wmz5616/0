/* pages/venueDetails/venueDetails.wxss */
.bc {
  height: 100vh;
  background-color: #f6f8fb;
  position: relative;
  overflow: hidden;
}

.swiper {
  box-sizing: border-box;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.sImg {
  height: 320rpx;
  width: 690rpx;
  box-shadow: 0rpx 0rpx 14rpx -3rpx rgba(0, 68, 90, 0.14);
  border-radius: 16rpx;
}

.info {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  padding: 30rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  box-shadow: 0rpx 0rpx 14rpx -3rpx rgba(0, 68, 90, 0.14);
  border-radius: 16rpx;
  width: 100%;
}

.tInfo {
  display: flex;
  gap: 20rpx;
  align-items: center;
}

.title {
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
}

.tis {
  height: 42rpx;
  width: 99rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #EFFDFF;
  border-radius: 21rpx;
  font-size: 24rpx;
  color: #04C0D9;
  font-weight: 400;
}

.item {
  display: flex;
  gap: 10rpx;
  align-items: center;
}

.icon {
  height: 30rpx;
  width: 30rpx;
}

.grayText {
  font-size: 24rpx;
  color: #5D5C61;
  font-weight: 400;
}

.Cflex {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.sBottom {
  padding: 30rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  box-shadow: 0rpx 0rpx 14rpx -3rpx rgba(0, 68, 90, 0.14);
  border-radius: 16rpx;
  width: 100%;
}

.tab {
  display: flex;
  gap: 40rpx;
  position: relative;
}

.line {
  position: absolute;
  left: 0rpx;
  bottom: 0rpx;
  height: 4rpx;
  width: 128rpx;
  background: #04C0D9;
  border-radius: 2rpx;
  transition: all 0.2s linear;
}

.baseTab {
  width: 128rpx;
  padding-bottom: 26rpx;
  box-sizing: border-box;
  font-size: 32rpx;
  color: #333333;
  text-align: center;
  line-height: 42rpx;
  font-weight: 400;
}

.activeTab {
  color: #04C0D9;
}

.detail {
  font-size: 30rpx;
  color: #333333;
  text-align: justify;
  line-height: 48rpx;
  font-weight: 400;
  padding-top: 30rpx;
  box-sizing: border-box;
}