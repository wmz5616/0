.bc {
  height: 100vh;
  background-color: rgba(249, 249, 249, 0.979);
  position: relative;
  overflow: hidden;
}

.LRP30 {
  padding: 0 30rpx;
}
.flex1{
  justify-content: flex-end !important;
}

.flex {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.tab .van-tabs__line {
  width: 240rpx !important;
}

.tab .van-tab {
  flex-basis: 33.33333% !important;
}

.swiper {
  width: 100%;
  height: calc(100vh - 382rpx);
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  overflow-y: auto;
}

.title {
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
}

.header {
  padding: 24rpx 30rpx;
}

.Btn {
  height: 50rpx;
  background-image: linear-gradient(270deg, #5DD5DE 3%, #4EACD3 100%);
  border-radius: 8rpx;
  padding: 8rpx 24rpx;
  box-sizing: border-box;
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: 400;
  display: flex;
  gap: 14rpx;
  align-items: center;
  flex-shrink: 0;
}

.rightIcon {
  height: 23rpx;
  width: 13rpx;
}

.middle {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.m_header {
  display: flex;
  align-items: center;
}

.b_bottom {
  box-sizing: border-box;
  padding-bottom: 30rpx;
  border-bottom: 1rpx solid #DDD;
}

.m_title {
  font-size: 32rpx;
  color: #333333;
  line-height: 51rpx;
  font-weight: 400;
}

.require::before {
  content: '*';
  color: red;
}

.m_midde {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
}

.color {
  color: #0F1741;
}

.graytext {
  font-size: 26rpx;
  color: #C7C7CC;
  font-weight: 400;
}

.m_bottom {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.textarea {
  width: 100%;
  border: 1px solid rgba(221, 221, 221, 1);
  border-radius: 18rpx;
  padding: 30rpx;
  box-sizing: border-box;
  min-height: 200rpx;
}

.Btn1 {
  padding: 0rpx 60rpx 30rpx 60rpx;
  display: flex;
  justify-content: center;
}

.btn1 {
  background-image: linear-gradient(192deg, #5DD5DE 0%, #4EACD3 84%);
  border-radius: 46rpx;
  width: 100%;
  padding: 22rpx 0rpx;
  box-sizing: border-box;
  font-size: 32rpx;
  color: #FFFFFF;
  line-height: 48rpx;
  font-weight: 400;
  display: flex;
  justify-content: center;
  align-items: center;
}