.bc {
  height: 100vh;
  background-color: rgba(249, 249, 249, 0.979);
  position: relative;
  overflow: hidden;
}

.LRP30 {
  padding: 0 30rpx;
}

.flex {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.swiper {
  width: 100%;
  height: calc(100vh - 180rpx);
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  overflow-y: auto;
  justify-content: space-between;
}


.van-field__label {
  font-size: 32rpx;
  color: #36444E;
}

.btn {
  height: 92rpx;
  width: 330rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 60rpx;
  font-size: 32rpx;
  font-weight: 400;
  box-sizing: border-box;
}

.btn1 {
  background: #FFFFFF;
  color: #04C0D9;
  border: 1rpx solid #5DD5DE;
}

.btn2 {
  background-image: linear-gradient(195deg, #5DD5DE 0%, #4EACD3 84%);
  color: #FFFFFF;
}

.item {
  padding: 60rpx 30rpx;
  box-sizing: border-box;
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 30rpx;
}

title {
  font-size: 36rpx;
  color: #36444E;
}

.form {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  width: 100%;
}

.f_item {
  padding-bottom: 30rpx;
  box-sizing: border-box;
  width: 100%;
  border-bottom: 1rpx solid #E5E5E5;
}

.f_item:last-child {
  padding-bottom: 0rpx;
  border-bottom: none;
}
.f_item:first-child {
  padding-top: 30rpx;
}

.nomal_text {
  font-size: 30rpx;
  color: #36444E;
}

.gary_text {
  font-size: 30rpx;
  color: #999999;
}