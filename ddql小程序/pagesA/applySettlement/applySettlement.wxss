/* pages/applySettlement/applySettlement.wxss */
.bc {
  height: 100vh;
  overflow: hidden;
  background-color: #f8f8f8;
}

.imgBox {
  height: 160rpx;
  width: 160rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  box-sizing: border-box;
  border: 1rpx solid rgba(224, 223, 228, 1);
  border-radius: 8rpx;
}

.swiper {
  height: calc(100vh - 294rpx);
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  overflow: scroll;
}

.box {
  background: #FFFFFF;
  border-radius: 18rpx;
}

.Cflex {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  background-color: #FFFFFF;
}

.Rflex {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title {
  position: relative;
  font-size: 30rpx;
  color: #333333;
  font-weight: 400;
}

.require::before {
  position: absolute;
  left: -15rpx;
  top: 4rpx;
  display: block;
  content: '*';
  font-size: 30rpx;
  color: #FF3141;
  font-weight: 400;
}

.field {
  padding-bottom: 25rpx;
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid rgba(238, 238, 238, 1);
}

.input {
  text-align: right;
  flex-grow: 1;
  font-size: 30rpx;
  font-weight: 400;
}

.gap15 {
  display: flex;
  gap: 15rpx;
  align-items: center;
  font-size: 30rpx;
  font-weight: 400;
}

.grayText {
  font-size: 30rpx;
  font-weight: 400;
  color: #CCCCCC;
}

.selectText {
  font-size: 30rpx;
  font-weight: 400;
  color: #333333;
}

.gap30 {
  display: flex;
  gap: 30rpx;
  align-items: center;
}

.gap42 {
  display: flex;
  gap: 42rpx;
  align-items: center;
}


.btn {
  font-size: 30rpx;
  color: #FFFFFF;
  text-align: center;
  font-weight: 400;
  height: 58rpx;
  width: 168rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-image: linear-gradient(192deg, #5DD5DE 0%, #4EACD3 84%);
  border-radius: 8rpx;
}

.list {
  display: flex;
  align-items: center;
  gap: 27rpx;
}

.item {
  height: 40rpx;
  background: #F8F8F8;
  border: 1rpx solid rgba(224, 223, 228, 1);
  border-radius: 20rpx;
  padding: 0rpx 20rpx;
  box-sizing: border-box;
  font-size: 22rpx;
  color: #5D5C61;
  text-align: left;
  line-height: 36rpx;
  font-weight: 400;
  position: relative;
}

.badge::before {
  content: 'x';
  color: #FFFFFF;
  background: #999999;
  position: absolute;
  right: -6rpx;
  top: -6rpx;
  border-radius: 50%;
  height: 18rpx;
  width: 18rpx;
  font-size: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.vetical {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.textarea {
  font-size: 30rpx;
  font-weight: 400;
  border: 1rpx solid rgba(209, 209, 209, 1);
  border-radius: 8rpx;
  padding: 20rpx;
  box-sizing: border-box;
  width: 100%;
  min-height: 146rpx;
}

.nomal {
  font-size: 32rpx;
  text-align: center;
  font-weight: 400;
}

.red {
  color: #E62E3D;
}

.green {
  color: #2FCF16;
}

.noaudit {
  color: #FB6C00;
}

.gap12 {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.zizhi {
  font-size: 32rpx;
  color: #333333;
  font-weight: 500;
}

.Btn1 {
  width: 100%;
  padding-bottom: 30rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
}

.btn1 {
  height: 92rpx;
  width: 630rpx;
  background-image: linear-gradient(192deg, #5DD5DE 0%, #4EACD3 84%);
  border-radius: 46rpx;
  font-size: 32rpx;
  color: #FFFFFF;
  text-align: center;
  line-height: 48rpx;
  font-weight: 400;
  display: flex;
  justify-content: center;
  align-items: center;
}

.isIOS {
  padding-bottom: env(safe-area-inset-bottom);
}

.h336 {
  height: calc(100vh - 336rpx) !important;
}

.h180 {
  height: calc(100vh - 180rpx) !important;
}


.pickerTime {
  height: 110rpx;
  padding: 30rpx;
  box-sizing: border-box;
}

.p_avtiveText {
  font-size: 30rpx;
  color: #8153FC;
  font-weight: 400;
}

.p_text {
  font-size: 36rpx;
  padding-left: 33rpx;
  color: #333333;
  text-align: center;
  font-weight: 500;
}

.pTab .van-picker__cancel,
.pTab .van-picker__confirm {
  font-size: 30rpx;
  color: #04C0D9;
  font-weight: 400;
}

.pTab .van-picker__title {
  font-size: 36rpx;
  color: #333333;
  text-align: center;
  font-weight: 500;
}

.flex {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.info {
  display: flex;
  flex-direction: column;
  gap: 17rpx;
}

.nomalText {
  font-size: 30rpx;
  font-weight: 400;
}

.c666 {
  color: #666666;
}

.red {
  color: #E62E3D;
}

.success {
  color: #04C0D9;
}

.orange {
  color: #FB9B00;
}

.c333 {
  color: #333333;
}

.van-picker__confirm {
  color: #4EACD3 !important;
}

.banner .van-uploader__preview-image {
  height: 153rpx !important;
  width: 296rpx !important;
}

.logo .van-uploader__preview-image {
  height: 100rpx !important;
  width: 307rpx !important;
}