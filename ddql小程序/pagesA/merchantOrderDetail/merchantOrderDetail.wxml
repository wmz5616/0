<view class="container">
  <van-nav-bar bind:click-left="goBack" border="{{false}}">
    <view slot="left" class="backLeft" style="display:flex;align-items:center;">
      <image src="/assets/images/arrow-back.svg" class="arrowBack" mode="aspectFill" style="width:40rpx;height:40rpx;"></image>
    </view>
    <text slot="title" class="navText" style="font-weight:bold;font-size:32rpx;">交易记录详情</text>
  </van-nav-bar>

  <view class="content">
    <!-- 头部金额状态区 -->
    <view class="header-card">
      <view class="status-text" style="color: {{statusList[orderInfo.status].color || '#333'}}">{{statusList[orderInfo.status].text || '未知状态'}}</view>
      <view class="amount"><text class="symbol">￥</text>{{orderInfo.amount / 100 || '0.00'}}</view>
      <view class="time">{{orderInfo.createTime || ''}}</view>
    </view>

    <!-- 详细信息区 -->
    <view class="info-card">
      <view class="info-item">
        <text class="label">下单人</text>
        <text class="value">{{orderInfo.nickName || '--'}}</text>
      </view>
      <view class="info-item">
        <text class="label">抵扣金币数</text>
        <text class="value">{{orderInfo.coinAmount || '180'}}</text>
      </view>
      <view class="info-item">
        <text class="label">订单号</text>
        <view class="value-group">
          <text class="value">{{orderInfo.orderNo || '--'}}</text>
          <view class="copy-btn" bind:tap="copy" data-text="{{orderInfo.orderNo}}">复制</view>
        </view>
      </view>
      <view class="info-item" wx:if="{{orderInfo.reason}}">
        <text class="label">退款原因</text>
        <text class="value">{{orderInfo.reason}}</text>
      </view>
    </view>
  </view>
</view>
