page {
  background-color: #F7F8FA;
}

.container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

.content {
  padding: 30rpx;
}

.header-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 60rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
}

.status-text {
  font-size: 32rpx;
  font-weight: 500;
  margin-bottom: 24rpx;
}

.amount {
  font-size: 64rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 16rpx;
  display: flex;
  align-items: baseline;
}

.amount .symbol {
  font-size: 36rpx;
  margin-right: 4rpx;
}

.time {
  font-size: 24rpx;
  color: #999999;
}

.info-card {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 10rpx 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.02);
}

.info-item {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 30rpx 0;
  border-bottom: 1rpx solid #F5F5F5;
}

.info-item:last-child {
  border-bottom: none;
}

.label {
  font-size: 28rpx;
  color: #666666;
  flex-shrink: 0;
  margin-right: 40rpx;
  line-height: 40rpx;
}

.value {
  font-size: 28rpx;
  color: #333333;
  text-align: right;
  word-break: break-all;
  line-height: 40rpx;
}

.value-group {
  display: flex;
  align-items: center;
}

.copy-btn {
  margin-left: 20rpx;
  font-size: 22rpx;
  color: #04C0D9;
  border: 1rpx solid #04C0D9;
  border-radius: 6rpx;
  padding: 2rpx 12rpx;
  line-height: 32rpx;
}
