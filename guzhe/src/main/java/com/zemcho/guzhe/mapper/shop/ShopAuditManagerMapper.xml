<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.zemcho.guzhe.mapper.shop.ShopAuditManagerMapper">
    <sql id="field">
        shop_audit_id,
        sort,
        name,
        phone,
        head_manager
    </sql>

    <insert id="insert">
        INSERT INTO `shop_audit_manager`
        (<include refid="field"/>)
        VALUES
        (
        #{data.shopAuditId},
        #{data.sort},
        #{data.name},
        #{data.phone},
        #{data.headManager}
        )
    </insert>

    <select id="selectShopAuditIdsByPhone" resultType="java.lang.Integer">
        select shop_audit_id from shop_audit_manager where phone = #{phone}
    </select>

    <select id="selectByShopAuditId" resultType="com.zemcho.guzhe.entity.shop.ShopAuditManager">
        select * from shop_audit_manager where shop_audit_id = #{id}
    </select>

    <delete id="deleteByShopAuditId">
        delete from shop_audit_manager where shop_audit_id = #{id}
    </delete>
</mapper>