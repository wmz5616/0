.triangleupper{
  width: 0;
  height: 0;
  border-left: 18rpx solid transparent; /* 左侧边框透明 */
  border-right: 18rpx solid transparent; /* 右侧边框透明 */
  border-top: 18rpx solid #CCCCCC; /* 底部边框为红色，形成三角形 */
  position: relative; /* 相对定位，为背景提供基础 */
}

.trianglelower{
  width: 0;
  height: 0;
  border-left: 18rpx solid transparent; /* 左侧边框透明 */
  border-right: 18rpx solid transparent; /* 右侧边框透明 */
  border-bottom: 18rpx solid #CCCCCC; /* 底部边框为红色，形成三角形 */
  position: relative; /* 相对定位，为背景提供基础 */
}
