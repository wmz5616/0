.mark-table{
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 99;
  top:0;
  display:flex;
  align-items: center;
  justify-content:center;
}
.mark-table .table-warpper{
width:90%;
background-color:#fff;
height:80%;
padding:30rpx;
position: relative;
border-radius:12rpx;
box-sizing: border-box;
}
.table-container {
  /* border: 1rpx solid #ccc; */
  border-radius: 10rpx;
  overflow: hidden;
  border-bottom:1rpx solid #E5E5E5;
  padding-bottom:30rpx;
  margin-bottom:40rpx;
  padding-top:30rpx;
}

.table-header {
  display: flex;
  color:#333333;
  font-size:32rpx;
  /* background-color: #f0f0f0; */
  font-weight: bold;
}

.header-cell {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  /* border-right: 1rpx solid #ccc; */
}

.header-cell:last-child {
  border-right: none;
}

.table-body {
  position: relative;
  max-height:680rpx;
  overflow-y: auto;
}

.table-row {
  display: flex;
  background-color: #fff;
  transition: background-color 0.2s ease;
  margin-bottom:10rpx;
}

.table-row.dragging {
  background-color: #e0f7fa;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
}

.table-cell {
  flex: 1;
  padding: 20rpx;
  text-align: center;
  /* border-right: 1rpx solid #ccc;
  border-bottom: 1rpx solid #ccc; */
}

.table-cell:last-child {
  border-right: none;
}

.table-row:last-child .table-cell {
  border-bottom: none;
}
.btm-btn{
  position: absolute;
  bottom:0;
  display:flex;
  left:0;
  right:0;
  height:100rpx;
  line-height:100rpx;
  font-size:36rpx;
  border-top:1rpx solid #E5E5E5;
}
.add-btn{
  color: #999999;
letter-spacing: 0;
text-align: center;
height:74rpx;
width:447rpx;
margin:0 auto;
line-height:74rpx;
font-weight: 400;
border: 1rpx dashed rgba(204,204,204,1);
