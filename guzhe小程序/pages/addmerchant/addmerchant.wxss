/* pages/applySettlement/applySettlement.wxss */
.bc {
  height: 100vh;
  overflow: hidden;
  background-color: #f8f8f8;
}

.swiper {
  height: calc(100vh - 348rpx);
  margin: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  overflow: scroll;
}

.h180 {
  height: calc(100vh - 180rpx) !important;
}

.box {
  background: #FFFFFF;
  border-radius: 18rpx;
}

.Cflex {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  background-color: #FFFFFF;
}

.Rflex {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.title {
  position: relative;
  font-size: 30rpx;
  color: #333333;
  font-weight: 400;
  flex-shrink:0;
}

.require::before {
  position: absolute;
  left: -15rpx;
  top: 4rpx;
  display: block;
  content: '*';
  font-size: 30rpx;
  color: #FF3141;
  font-weight: 400;
}

.field {
  padding-bottom: 25rpx;
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  align-items: center;
  border-bottom: 1rpx solid rgba(238, 238, 238, 1);
  gap:40rpx;
}

.input {
  text-align: right;
  flex-grow: 1;
  font-size: 30rpx;
  font-weight: 400;
  padding-right: 25rpx;
}
.pHeader {
  flex-direction: column;
  padding: 0rpx 30rpx;
  box-sizing: border-box;
  height: 100%;
  width: 100%;
  position: relative;
  display: flex;
}
.clear {
  width: fit-content;
  height: 100%;
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: #666666;
  font-weight: 500;
}
.pTitle {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 36rpx;
  color: #333333;
  text-align: center;
  font-weight: 500;
}
.gap15 {
color:#CCCCCC;
display: flex;
justify-content: flex-end;
