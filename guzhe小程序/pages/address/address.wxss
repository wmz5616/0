.bc {
  height: 100vh;
  background-color: #f9f9f9;
  position: relative;
  overflow: hidden;
}

.LRP30 {
  padding: 0 30rpx;
}

.flex {
  display: flex;
  align-items: center;
  justify-content: space-between;
}


.swiper {
  width: 100%;
  height: calc(100vh - 298rpx);
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  overflow-y: auto;
}

.address_item {
  padding: 30rpx 0rpx 22rpx 0rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.a_t_left {
  display: flex;
  gap: 16rpx;
}

.fw400 {
  font-weight: 400rpx;
}

.close {
  height: 30rpx;
  width: 30rpx;
}

.atciveChose {
  height: 35rpx;
  width: 35rpx;
}

.a_middle {
  margin-bottom: 10rpx;
}

.a_m_right {
  padding: 8rpx 24rpx;
  box-sizing: border-box;
  border-radius: 8rpx;
  border: 1rpx solid #8153FC;
}

.addressInfo {
  width: 498rpx;
  height: 86rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.a_bottom {
  padding-top: 30rpx;
  border-top: 1rpx solid #F1F1F1;
  box-sizing: border-box;
}

.a_b_left {
  display: flex;
  gap: 12rpx;
  align-items: center;
}


.radio {
  height: 36rpx;
  width: 36rpx;
  border-radius: 50%;
  box-sizing: border-box;
  border: 1px solid rgba(163, 169, 175, 1);
  display: flex;
  justify-content: center;
  align-items: center;
  text-align: center;
}

.activeRadio {
  border: none;
}

.label {
  font-size: 30rpx;
  color: #8153FC;
  font-weight: 400;
}

.nomalLabel {
  font-size: 30rpx;
  color: #333;
  font-weight: 400;
}

.a_b_right {
  padding: 8rpx 24rpx;
  box-sizing: border-box;
  background-image: linear-gradient(176deg, #8153FC 0%, #6070FB 82%);
  border-radius: 8rpx;
  font-size: 30rpx;
  color: #FFFFFF;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
}

.Btn {
  position: absolute;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
}

.btn {
  background-image: linear-gradient(167deg, #8153FC 0%, #6070FB 82%);
  border-radius: 46rpx;
  padding: 22rpx 219rpx;
  box-sizing: border-box;
  font-size: 32rpx;
  color: #FFFFFF;
  line-height: 48rpx;
  font-weight: 400;
  display: flex;
  justify-content: center;
  align-items: center;
}

/* dialog */
.active4d .van-dialog__header {
  padding: 30rpx 46rpx !important;
}


.overlay {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.box_item {
  width: 630rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  position: relative;
}

.p-title {
  border-bottom: 0rpx;
  justify-content: center;
  position: relative;
  height: 110rpx;
  width: 100%;
  padding: 30rpx 29rpx;
  display: flex;
  align-items: center;
  box-sizing: border-box;
}

.p-text {
  text-align: center;
  position: relative;
  left: 0rpx;
  top: 0rpx;
  transform: translate(0rpx, 0rpx);
}

.llist {
  height: 502rpx;
  overflow-y: scroll;
  padding: 0rpx 30rpx;
  box-sizing: border-box;
  border-top: 1rpx solid #D8D8D8;
}

.locationList {
  padding: 20rpx 0rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #D8D8D8;
  width: 100%;
  display: flex;
  justify-content: space-between;
}

.locationList:last-child {
  border: none;
}

.l_left {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  width: 97%;
}

.grayTitle {
  font-size: 28rpx;
  color: #5D5C61;
  font-weight: 400;
}

.rightIcon {
  height: 28rpx;
  width: 16rpx;
  flex-shrink: 0;
}

.van-icon--image {
  height: 40rpx !important;
  width: 40rpx !important;
}

.o_content {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  width: 100%;
  border-top: 1rpx solid #D8D8D8;
  border-bottom: 1rpx solid #D8D8D8;
}

.vLabel {
  display: flex;
  justify-content: flex-end;
}

.field {
  padding-top: 24rpx !important;
  padding-bottom: 23rpx !important;
}

.field .van-field__control--disabled{
  color: #323233 !important;
}

.field1.van-cell:after {
  border-bottom: 0rpx !important;
}

.van-cell__title {
  max-width: 6.9em !important;
  margin-right: 9rpx !important;
}

.title {
  font-size: 34rpx;
  color: #333333;
  font-weight: 400;
  position: relative;
  flex-shrink: 0;
}

.require::before {
  display: inline-block;
  content: '*';
  color: #E62E3D;
  position: absolute;
  left: 0rpx;
  top: 0rpx;
  transform: translate(-100%, 5%);
}

.footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  height: 88rpx;
  width: 100%;
}

.line {
  width: 1rpx;
  height: 100%;
  background: #E5E5E5;
}

.base {
  box-sizing: border-box;
  flex-grow: 1;
  height: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 36rpx;
  color: #333333;
  line-height: 42rpx;
  font-weight: 400;
}

.activeText {
  color: #8153FC;
}

.angle {
  display: block;
  height: 1rpx;
  border: 15rpx solid #fff;
  border-color: transparent transparent #fff transparent;
  position: absolute;
  z-index: 2;
  bottom: 78rpx;
  left: 218rpx;
}

.detail {
  position: absolute;
  max-width: 488rpx;
  height: 334rpx;
  overflow: scroll;
  left: 163rpx;
  bottom: -254rpx;
  z-index: 1;
  background: #FFFFFF;
  box-shadow: 0rpx 5rpx 32rpx 0rpx rgba(51, 51, 51, 0.25);
  border-radius: 18rpx;
  display: flex;
  flex-direction: column;
  padding-top: 30rpx;
  box-sizing: border-box;
}

.locationItem {
  padding: 30rpx;
  border-bottom: 1rpx solid #D8D8D8;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 11rpx;
}

.locationItem:last-child {
  border-bottom: none;
}

.info {
  font-size: 28rpx;
  color: #333333;
  line-height: 41rpx;
  font-weight: 400;
}

.ellipsis {
  text-overflow: ellipsis;
  white-space: nowrap;
  overflow: hidden;
}

.pos {
  width: 40rpx;
  height: 36rpx;
  position: absolute;
  left: 40rpx;
  top: 50%;
  transform: translate(-50%, -50%);
}