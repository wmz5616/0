/* pages/coupon/coupon.wxss */

.flex {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.swiper {
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  overflow-y: auto;
  height: calc(100vh - 180rpx);
  position: relative;
}

.cTop {
  justify-content: flex-start;
  position: relative;
  overflow: hidden;
}

.sTop {
  overflow: hidden;
  position: relative;
  width: 100%;
  flex-shrink: 0;
  background: #FFFFFF;
  box-shadow: 0rpx 2rpx 10rpx 0rpx rgba(0, 0, 0, 0.2);
  border-radius: 18rpx;
}

.Icon {
  height: 151rpx;
  width: 200rpx;
  position: absolute;
  right: 0rpx;
  top: 0rpx;
  transform: translate(52rpx, -40rpx);
}

.Img {
  height: 152rpx;
  width: 270rpx;
  border-radius: 18rpx;
}


.title {
  font-size: 30rpx;
  color: #000000;
  letter-spacing: 0;
  font-weight: 500;
}

.time {
  font-size: 20rpx;
  color: #333333;
  text-align: left;
  font-weight: 400;
}


.asdd {
  width: 100%;
  height: 1px;
  background-image: linear-gradient(to right, rgba(187, 186, 193, 0.50) 0%, rgba(187, 186, 193, 0.50) 50%, transparent 50%);
  background-size: 13px 1px;
  background-repeat: repeat-x;
  position: relative;
}

.asdd .left-ctrile {
  width: 40rpx;
  height: 40rpx;
  background-color: #f9f9f9;
  border-radius: 40rpx;
  position: absolute;
  right: -20rpx;
  z-index: 1;
  top: -20rpx;
}

.asdd .right-ctrile {
  width: 40rpx;
  height: 40rpx;
  background-color: #f9f9f9;
  border-radius: 40rpx;
  position: absolute;
  left: -20rpx;
  z-index: 1;
  top: -20rpx;
}

.code {
  position: relative;
  font-size: 32rpx;
  color: #333333;
  letter-spacing: 1.5rpx;
  font-weight: 500;
}

.underline {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 100%;
  height: 1rpx;
  background-color: black;
}

.couponList {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  box-sizing: border-box;
}

.baseItem {
  border-radius: 18rpx;
  background-color: #fff;
  padding: 30rpx;
  box-sizing: border-box;
}

.activeItem {
  background-image: linear-gradient(171deg, #8153FC 0%, #6070FB 82%);
}

.left {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.listText {
  font-size: 32rpx;
  color: #FFFFFF;
  line-height: 50rpx;
  font-weight: 500;
}

.f28 {
  font-size: 28rpx;
  font-weight: 400;
}

.right{
  height: 88rpx;
  width: 88rpx;
  border-radius: 50%;
  background-color: #fff;
  box-sizing: border-box;
  display: flex;
  justify-content: center;
  align-items: center;
}

.purple{
  border: 4rpx solid #bfbbff;
}

.orange{
  border: 4rpx solid #fff2b5;
}

.iconImg{
  height: 44rpx;
  width: 44rpx;
}

.pud46{
  padding-top: 46rpx;
  padding-bottom: 46rpx;
  border: 1rpx solid rgba(221,221,221,1);
}

.gray{
  color: #CCCCCC;
}

.grayText1{
  position: relative;
}

.grayText1::before{
  content: '';
  width: 100%;
  height: 1rpx;
  background-color: #CCCCCC;
  position: absolute;
  left: 0rpx;
  top: 50%;
}

.selectItem{
  background-image: linear-gradient(165deg, #FFBC28 1%, #FECE4D 100%);
}

.cBottom{
  align-items: center;
}