.bc {
  height: 100vh;
  background-color: #f9f9f9;
  position: relative;
  overflow: hidden;
}

.LRP30 {
  padding: 0 30rpx;
}

.purple{
  color: #8153FC !important;
}

.flex {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.swiper {
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  overflow-y: auto;
  height: calc(100vh - 302rpx);
  position: relative;
}

.base {
  box-sizing: border-box;
  padding: 0rpx 30rpx;
  height: 92rpx;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  border-radius: 46rpx;
  font-size: 32rpx;
  text-align: center;
  line-height: 48rpx;
  font-weight: 400;
}

.nomal {
  background: #FFFFFF;
  color: #8153FC;
  border: 1rpx solid #8153FC;
}

.active {
  background-image: linear-gradient(167deg, #8153FC 0%, #6070FB 82%);
  color: #fff;
}

.label {
  font-size: 34rpx;
  color: #000000;
  font-weight: 400;
}

.van-cell__title {
  min-width: 3.2em !important;
  max-width: 3.2em !important;
}

/* dialog */
.van-dialog__header {
  padding-top: 46rpx !important;
  padding-bottom: 46rpx !important;
}

.d_content {
  margin-top: -16rpx;
  font-size: 32rpx;
}

.field {
  border-radius: 16rpx;
}

.van-field__placeholder {
  font-size: 34rpx;
  color: #B2B2B2;
  letter-spacing: 0;
  font-weight: 400;
}

.van-field__control{
  font-size: 34rpx;
}