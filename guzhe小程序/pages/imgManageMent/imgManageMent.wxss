/* pages/imgManageMent/imgManageMent.wxss */
.box {
  background: #FFFFFF;
  border-radius: 18rpx;
}

.swiper {
  height: calc(100vh - 294rpx);
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  overflow: scroll;
}

.bc {
  height: 100vh;
  overflow: hidden;
  background-color: #f8f8f8;
}


.title {
  position: relative;
  font-size: 30rpx;
  color: #333333;
  font-weight: 400;
}

.require::before {
  position: absolute;
  left: -15rpx;
  top: 4rpx;
  display: block;
  content: '*';
  font-size: 30rpx;
  color: #FF3141;
  font-weight: 400;
}

.Cflex {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  background-color: #FFFFFF;
}


.Btn1 {
  width: 100%;
  padding-bottom: 30rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  box-sizing: border-box;
}

.btn1 {
  height: 92rpx;
  width: 630rpx;
  background-image: linear-gradient(174deg, #8153FC 0%, #6070FB 82%);
  border-radius: 46rpx;
  font-size: 32rpx;
  color: #FFFFFF;
  text-align: center;
  line-height: 48rpx;
  font-weight: 400;
  display: flex;
  justify-content: center;
  align-items: center;
}

.isIOS {
  padding-bottom: env(safe-area-inset-bottom);
}

.h336 {
  height: calc(100vh - 336rpx);
}