/* pages/myOrder/myOrder.wxss */
.bc {
  overflow: hidden;
  background-color: #f9f9f9;
}


.line {
  height: 4rpx;
  width: 188rpx;
  position: absolute;
  left: 150rpx;
  bottom: 0rpx;
  transition: all 0.3s linear;
  background-image: linear-gradient(270deg, #5DD5DE 3%, #4EACD3 100%);
  border-radius: 2rpx;
}

.pup {
  height: 89rpx;
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #FFFFFF;
}

.selectTime {
  height: 100%;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 30rpx;
  color: #333333;
  text-align: center;
  font-weight: 400;
  padding-left: 30rpx;
}

.up {
  transform: rotate(180deg);
}


.pickerTime {
  height: 110rpx;
  padding: 30rpx;
  box-sizing: border-box;
}

.p_avtiveText {
  font-size: 30rpx;
  color: #8153FC;
  font-weight: 400;
}

.p_text {
  font-size: 36rpx;
  padding-left: 33rpx;
  color: #333333;
  text-align: center;
  font-weight: 500;
}

.pTab .van-picker__cancel,
.pTab .van-picker__confirm {
  font-size: 30rpx;
  color: #04C0D9;
  font-weight: 400;
}

.pTab .van-picker__title {
  font-size: 36rpx;
  color: #333333;
  text-align: center;
  font-weight: 500;
}

.flex {
  display: flex;
  align-items: center;
  justify-content: space-between;
}


/* 筛选 */

.overlay {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.field1 {
  border: 1px solid rgba(209, 209, 209, 1);
  border-radius: 8rpx;
  padding: 13rpx 20rpx !important;
}

.box_item {
  width: 540rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
}

.p-title {
  border-bottom: 0rpx;
}

.o_content {
  padding: 30rpx;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  border-top: 1rpx solid #D8D8D8;
  border-bottom: 1rpx solid #D8D8D8;
}

.o_text {
  font-size: 32rpx;
  color: #333333;
  font-weight: 400;
}

.o_input {
  border: 1px solid rgba(209, 209, 209, 1);
  border-radius: 8rpx;
  padding: 13rpx 0rpx 13rpx 20rpx;
}

.footer {
  display: flex;
  justify-content: center;
  width: 100%;
  height: 88rpx;
}

.f_line {
  height: 100%;
  width: 1rpx;
  background: #E5E5E5;
}

.f_base {
  height: 100%;
  font-size: 36rpx;
  text-align: center;
  font-weight: 400;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-grow: 1;
}

.cancle {
  color: #333333;
}

.comfirm {
  color: #6070FB;
}

.tis {
  font-size: 28rpx;
  color: #F86E21;
  line-height: 28rpx;
  font-weight: 400;
  height: 72rpx;
  width: 100%;
  display: flex;
  align-items: center;
  padding: 0rpx 30rpx;
  box-sizing: border-box;
  background: #FDFCEC;
}

.van-field__control--disabled{
  color: #333 !important;
  font-size: 32rpx;
}

.swiper {
  width: 100%;
  height: calc(100vh - 264rpx);
  box-sizing: border-box;
}

.h328{
  height: calc(100vh - 328rpx);
}

.item {
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  margin: 30rpx 30rpx 0rpx 30rpx;
  background: #FFFFFF;
  box-shadow: 0rpx 2rpx 10rpx 0rpx rgba(0, 0, 0, 0.05);
  border-radius: 18rpx;
}

.header {
  border-bottom: 1rpx solid #dddddd;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 30rpx;
  box-sizing: border-box;
}

.title {
  font-size: 32rpx;
  color: #333333;
  line-height: 51rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.gap24 {
  display: flex;
  gap: 24rpx;
  align-items: center;
}

.nomal {
  font-size: 32rpx;
  color: #333;
  color: #04C0D9;
  line-height: 51rpx;
  font-weight: 400;
}

.red {
  color: #E62E3D;
}

.info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.flex {
  display: flex;
  justify-content: space-between;
}

.text {
  font-size: 28rpx;
  color: #333333;
  font-weight: 400;
}


.h616{
  height: calc(100vh - 616rpx) !important;
}

.isIOS {
  padding-bottom: calc(15rpx + env(safe-area-inset-bottom)) !important;
}

.btn {
  background: #FFFFFF !important;
  border: 1rpx solid rgba(221, 221, 221, 1) !important;
  border-radius: 10rpx !important;
  height: 94rpx !important;
  width: 168rpx !important;
  font-size: 36rpx !important;
  color: #000000 !important;
  line-height: 36rpx !important;
  font-weight: 400;
}

.page {
  font-size: 36rpx;
  color: #000000;
  line-height: 36rpx;
  font-weight: 400;
}

.activePage {
  color: #04C0D9;
}

.p-title {
  border-bottom: 0rpx;
  height: 108rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
}

.van-picker__confirm{
  color: #6070FB !important;
}