/* pages/storeManage/storeManage.wxss */
.bc {
  height: 100vh;
  overflow: hidden;
  background-color: #f8f8f8;
}

.grayText {
  font-size: 30rpx;
  color: #666666;
  text-align: center;
  font-weight: 400;
}

.empty {
  width: 100%;
  padding-top: 30rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
}

.swiper {
  height: calc(100vh - 220rpx);
}

.h284 {
  height: calc(100vh - 284rpx);
}

.shadow {
  background: #FFFFFF;
  box-shadow: 0rpx 2rpx 10rpx 0rpx rgba(0, 0, 0, 0.05);
  border-radius: 18rpx;
}

.item {
  margin: 30rpx 30rpx 0rpx 30rpx;
  position: relative;
}

.left {
  height: 146rpx;
  width: 690rpx;
  background-color: #FFFFFF;
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: space-between;
  position: relative;
}

.badge {
  border-radius: 50%;
  background: #E62E3D;
  color: #FFFFFF;
  height: 50rpx;
  width: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: absolute;
  top: -15rpx;
  right: 0rpx;
  font-size: 20rpx;
  line-height: 20rpx;
}

.l_left {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.avatar {
  height: 106rpx;
  width: 106rpx;
  border-radius: 50%;
}

.shopName {
  font-size: 30rpx;
  color: #333333;
  font-weight: 500;
}

.nomal {
  font-size: 30rpx;
  color: #999999;
  font-weight: 400;
  margin-left: 4rpx;
}

.success {
  color: #2FCF16;
}

.red {
  color: #E62E3D;
}

.orange {
  color: #FB9B00;
}


.baseSwipe {
  height: 100%;
  width: 120rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 30rpx;
  color: #FFFFFF;
  text-align: center;
  font-weight: 400;
}

.delete {
  background: #E62E3D;
  border-radius: 0rpx 18rpx 18rpx 0rpx;
}

.slotRight {
  height: 100%;
  width: 120rpx;
}

.Btn {
  padding: 0rpx 30rpx 30rpx 30rpx;
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.btn {
  height: 90rpx;
  width: 330rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: #FFFFFF;
  text-align: center;
  font-weight: 400;
  background-image: linear-gradient(173deg, #8153FC 0%, #6070FB 82%);
  border-radius: 60rpx;
}

.activeBtn {
  border: 1rpx solid #8153FC;
  color: #8153FC;
  background-image: none;
  background-color: #FFFFFF;
  box-sizing: border-box;
  position: relative;
}