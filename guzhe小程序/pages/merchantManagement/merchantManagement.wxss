/* pages/merchantManagement/merchantManagement.wxss */
.swiper {
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  overflow-y: auto;
  height: calc(100vh - 180rpx);
  position: relative;
}

.header {
  display: flex;
  flex-direction: column;
}

.hTop {
  border-bottom: 2rpx solid #E5E5E5;
  padding-bottom: 30rpx;
  display: flex;
  align-items: center;
}

.round {
  border-radius: 50%;
  background: #E62E3D;
  color: #FFFFFF;
  height: 30rpx;
  width: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  position: absolute;
  top: 0rpx;
  right: 0rpx;
  font-size: 18rpx;
  line-height: 20rpx;
}

.shopName {
  font-size: 32rpx;
  color: #333333;
  letter-spacing: 0;
  line-height: 50rpx;
  font-weight: 400;
}

.hBom {
  display: flex;
  align-items: center;
}

.time {
  font-size: 30rpx;
  color: #333333;
  text-align: center;
  line-height: 42rpx;
  font-weight: 400;
}

.hbRight {
  height: 15rpx;
  width: 30rpx;
  transition: all 0.3s linear;
}

.hbLeft {
  display: flex;
  gap: 5rpx;
  align-items: center;
}

.up {
  transform: rotate(180deg);
}

.p_box {
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  gap: 30rpx;
  flex-direction: column;
}

.p_top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 30rpx;
}

.basebox {
  height: 60rpx;
  padding: 30rpx;
  box-sizing: border-box;
  border: 1rpx solid rgba(224, 223, 228, 1);
  border-radius: 12rpx;
  flex-grow: 1;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.activeBox {
  border-color: rgba(129, 83, 252, 1);
  color: #8153FC;
}

.tHeader {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.taText {
  font-size: 30rpx;
  color: #8153FC;
  font-weight: 400;
}

.tTitle {
  font-size: 36rpx;
  color: #333333;
  text-align: center;
  font-weight: 500;
}

.middle {
  display: flex;
  align-items: center;
}

.item {
  background: #E9ECFF;
  border-radius: 16rpx;
  height: 140rpx;
  width: 210rpx;
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.imgB {
  position: absolute;
  left: 0;
  top: 0;
  height: 140rpx;
  width: 210rpx;
}

.mTitle {
  font-size: 32rpx;
  color: #333333;
  letter-spacing: -0.29rpx;
  text-align: center;
  font-weight: 500;
  position: relative;
}

.mGray {
  font-size: 24rpx;
  color: #666666;
  letter-spacing: -0.21rpx;
  text-align: center;
  font-weight: 400;
  position: relative;
}

.footer {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-template-rows: repeat(3, auto);
  gap: 60rpx 10rpx;
}

.iIcon {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
  position: relative;
}

.Icon {
  height: 80rpx;
  width: 80rpx;
}

.fGray {
  font-size: 26rpx;
  color: #666666;
  letter-spacing: 0;
  font-weight: 400;
}