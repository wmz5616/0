/* pages/noticeDetail/noticeDetail.wxss */
page {
  background-color: #f5f5f5;
}

.navText {
  font-size: 37rpx;
  color: #333333;
  font-weight: 500;
}

.notice-container {
  width: 690rpx;
  margin: 0 auto;
  padding: 30rpx;
  background-color: #ffffff;
}

.notice-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #333333;
  line-height: 1.5;
  word-wrap: break-word;
  word-break: break-all;
}

.notice-time {
  font-size: 24rpx;
  color: #999999;
  margin-top: 20rpx;
  margin-bottom: 20rpx;
}

.notice-divider {
  height: 1rpx;
  background-color: #eeeeee;
  margin-bottom: 30rpx;
}

.wxParse {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.8;
}

.wxParse image {
  max-width: 100% !important;
  height: auto !important;
  margin: 20rpx 0;
}

.wxParse p {
  margin-bottom: 20rpx;
}