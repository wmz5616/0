/* pages/myOrder/myOrder.wxss */
.bc {
  overflow: hidden;
  background-color: #f9f9f9;
}

.tab {
  height: 90rpx;
  width: 100%;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
  box-sizing: border-box;
  border-bottom: 1rpx #f1f1f1 solid;
  gap: 80rpx;
  background-color: #FFFFFF;
}

.van-field__control--disabled{
  color: #333333 !important;
  font-size: 32rpx;
}

.pup {
  height: 89rpx;
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #FFFFFF;
}

.selectTime {
  height: 100%;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 30rpx;
  color: #333333;
  text-align: center;
  font-weight: 400;
  padding-left: 30rpx;
}

.up {
  transform: rotate(180deg);
}


.pickerTime {
  height: 110rpx;
  padding: 30rpx;
  box-sizing: border-box;
}

.p_avtiveText {
  font-size: 30rpx;
  color: #8153FC;
  font-weight: 400;
}

.p_text {
  font-size: 36rpx;
  color: #333333;
  text-align: center;
  font-weight: 500;
}

.e_text {
  font-size: 34rpx;
  color: #333333;
  font-weight: 400;
}

.pTab .van-picker__cancel,
.pTab .van-picker__confirm {
  font-size: 30rpx;
  color: #04C0D9;
  font-weight: 400;
}

.pTab .van-picker__title {
  font-size: 36rpx;
  color: #333333;
  text-align: center;
  font-weight: 500;
}

.flex {
  display: flex;
  align-items: center;
  justify-content: space-between;
}


/* 筛选 */

.overlay {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100%;
}

.field1 {
  border: 1px solid rgba(209, 209, 209, 1);
  border-radius: 8rpx;
  padding: 13rpx 20rpx !important;
}

.box_item {
  width: 540rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
}

.p-text {
  font-size: 36rpx;
  color: #333333;
  text-align: center;
  line-height: 48rpx;
  font-weight: 400;
}

.p-title {
  border-bottom: 0rpx;
  height: 108rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  position: relative;
}

.o_content {
  padding: 30rpx;
  width: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  border-top: 1rpx solid #D8D8D8;
  border-bottom: 1rpx solid #D8D8D8;
}

.o_text {
  font-size: 32rpx;
  color: #333333;
  font-weight: 400;
}

.o_input {
  border: 1px solid rgba(209, 209, 209, 1);
  border-radius: 8rpx;
  padding: 13rpx 0rpx 13rpx 20rpx;
}

.footer {
  display: flex;
  justify-content: center;
  width: 100%;
  height: 88rpx;
}

.f_line {
  height: 100%;
  width: 1rpx;
  background: #E5E5E5;
}

.f_base {
  height: 100%;
  font-size: 36rpx;
  text-align: center;
  font-weight: 400;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-grow: 1;
}

.cancle {
  color: #333333;
}

.comfirm {
  color: #8153FC;
}

.tis {
  font-size: 24rpx;
  color: #F86E21;
  line-height: 28rpx;
  font-weight: 400;
  height: 72rpx;
  width: 100%;
  display: flex;
  align-items: center;
  padding: 0rpx 10rpx;
  box-sizing: border-box;
  background: #FDFCEC;
}

.swiper {
  width: 100%;
  height: calc(100vh - 458rpx);
  box-sizing: border-box;
  overflow: scroll;
}

.item {
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  margin: 30rpx 30rpx 0rpx 30rpx;
  background: #FFFFFF;
  box-shadow: 0rpx 2rpx 10rpx 0rpx rgba(0, 0, 0, 0.05);
  border-radius: 18rpx;
}

.header {
  border-bottom: 1rpx solid #dddddd;
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-bottom: 30rpx;
  box-sizing: border-box;
}

.title {
  font-size: 30rpx;
  color: #333333;
  letter-spacing: 0;
  line-height: 51rpx;
  font-weight: 500;
}

.gap24 {
  display: flex;
  gap: 24rpx;
  align-items: center;
}

.nomal {
  font-size: 32rpx;
  letter-spacing: 0;
  text-align: right;
  line-height: 51rpx;
  font-weight: 400;
}

.p_item1{
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.info {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.flex {
  display: flex;
  justify-content: space-between;
}

.text {
  font-size: 28rpx;
  color: #333333;
  font-weight: 400;
}

.h616 {
  height: calc(100vh - 496rpx) !important;
}

.isIOS {
  padding-bottom: env(safe-area-inset-bottom) !important;
}

.btnText {
  font-size: 32rpx;
  color: #FFFFFF;
  text-align: center;
  line-height: 48rpx;
  font-weight: 400;
}

.footer1 {
  padding: 0rpx 30rpx 30rpx 30rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.Btn {
  background-image: linear-gradient(167deg, #8153FC 0%, #6A67FB 56%, #6A67FB 56%, #6070FB 82%);
  border-radius: 46rpx;
  height: 92rpx;
  width: 630rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10rpx;
}

.baseBtn {
  height: 60rpx;
  width: 172rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 28rpx;
  text-align: center;
  line-height: 32rpx;
  font-weight: 400;
  box-sizing: border-box;
  border-radius: 50rpx;
}

.refundBtn {
  border: 2rpx solid #6070FB;
  color: #6070FB;
}

.refundAudit {
  background-image: linear-gradient(174deg, #8153FC 0%, #6070FB 82%);
  color: #FFFFFF;
}

.popup-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.tit {
  width: 100%;
  height: 110rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.rtitle {
  font-size: 34rpx;
  font-weight: 500;
  color: #333333;
}


.p_center {
  width: 100%;
  border-bottom: 1px solid #E5E5E5;
  box-sizing: border-box;
  padding: 30rpx;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.p_item {
  display: flex;
  gap: 10rpx;
  align-items: center;
  gap: 25rpx;
}

.step {
  display: flex;
  height: 72rpx;
  width: 291rpx;
}

.s-item {
  display: flex;
  border-radius: 0rpx 12rpx 12rpx 0rpx;
  border: 1px solid rgba(209, 209, 209, 1);
  border-left: 0;
  flex-direction: column;
  padding: 0rpx 30rpx;
  justify-content: space-between;
}

.step-item {
  height: 1rpx;
  width: 1rpx;
  border: 15rpx solid transparent;
}

.up1 {
  border-bottom-color: #d0d0d1;
}

.down {
  border-top-color: #d0d0d1;
}

.active1 {
  border-bottom-color: #8153FC;
}

.active2 {
  border-top-color: #8153FC;
}

.p_input {
  border-radius: 12rpx 0rpx 0rpx 12rpx;
  border: 1px solid rgba(209, 209, 209, 1);
  padding: 15rpx 0rpx 15rpx 30rpx;
  box-sizing: border-box;
  height: 100%;
}

.p_textarea {
  width: 100%;
  height: 120rpx;
  border: 1px solid rgba(209, 209, 209, 1);
  border-radius: 8px;
  padding: 20rpx 20rpx 0 20rpx;
  box-sizing: border-box;
}

.p_text {
  flex-shrink: 0;
}


.oBox {
  width: 540rpx;
  background: #FFFFFF;
  border-radius: 12px;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  padding-top: 30rpx;
  box-sizing: border-box;
  position: relative;
}

.obHeader {
  display: flex;
  justify-content: center;
  align-items: center;
}

.obTitle {
  font-size: 36rpx;
  color: #333333;
  text-align: center;
  line-height: 48rpx;
  font-weight: 400;
}


.eMiddle {
  padding: 0 30rpx;
  box-sizing: border-box;
  display: flex;
  justify-content: space-between;
}

.eText {
  font-size: 28rpx;
  color: #333333;
  letter-spacing: 0;
  line-height: 42rpx;
  font-weight: 400;
}

.eBottom {
  display: flex;
  width: 100%;
  border-top: 1rpx solid #e5e5e5;
}


.showSearch {
  position: absolute;
  right: 0rpx;
  bottom: 193rpx;
  height: 155rpx;
  width: 104rpx;
  background-image: linear-gradient(180deg, #FFFFFF 0%, #FFFFFF 100%);
  box-shadow: 0rpx 2rpx 4rpx 0rpx rgba(163, 169, 175, 1);
  border-radius: 12rpx 0rpx 0rpx 12rpx;
  padding: 30rpx 20rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  gap: 10rpx;
}

.searchIcon {
  height: 40rpx;
  width: 41rpx;
}

.searchText {
  font-size: 32rpx;
  color: #8153FC;
  letter-spacing: 0;
  text-align: center;
  font-weight: 400;
}

.upload {
  height: 72rpx;
  width: 230rpx;
  border: 1rpx solid rgba(209, 209, 209, 1);
  border-radius: 8rpx;
  padding: 20rpx 30rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.grayText {
  color: #999999;
  font-size: 30rpx;
}

.extentText {
  font-size: 26rpx;
  color: #666666;
  font-weight: 400;
}
