/* pages/screenBoothRental/screenBoothRental.wxss */
.swiper {
  box-sizing: border-box;
  height: calc(100vh - 686rpx);
  position: relative;
}
.h636{
  height: calc(100vh - 636rpx) !important; 
}
.header {
  background: #FFFFFF;
  height: 102rpx;
  width: 100%;
  padding: 0rpx 30rpx;
  box-sizing: border-box;
}

.hItem {
  height: 100%;
}

.up {
  transform: rotate(180deg);
}

.hbRight {
  height: 15rpx;
  width: 30rpx;
  transition: all 0.3s linear;
}

.more {
  height: 35rpx;
  width: 22rpx;
}


.popu {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  align-items: center;
  width: 100%;
  padding-top: 42rpx;
}

.title {
  font-size: 30rpx;
  color: #333333;
  font-weight: 400;
}

.pop.van-popup--top {
  top: 180rpx;
}

.circleList {
  display: flex;
  flex-wrap: wrap;
  gap: 30rpx 20rpx;
  width: 100%;
}

.item {
  padding: 8rpx 24rpx;
  box-sizing: border-box;
  font-family: PingFangSC-Regular;
  font-size: 30rpx;
  color: #333333;
  text-align: center;
  font-weight: 400;
  background: #F5F4F9;
  border-radius: 8rpx;
}

.activeTab {
  background: #8153FC;
  color: #FFFFFF;
}

.clear {
  width: fit-content;
  height: 100%;
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: #666666;
  font-weight: 500;
}

.pHeader {
  height: 100%;
  width: 100%;
  position: relative;
  display: flex;
}

.pTitle {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  font-size: 36rpx;
  color: #333333;
  text-align: center;
  font-weight: 500;
}

.van-tab--active {
  color: #8153FC !important;
}

.place {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  padding: 30rpx 0rpx;
  box-sizing: border-box;
  background: #FFFFFF;
  margin-top: 30rpx;
}

.pHeader {
  display: flex;
  flex-direction: column;
  padding: 0rpx 30rpx;
  box-sizing: border-box;
}

.phTop {
  display: flex;
  gap: 14rpx;
  align-items: center;
}

.Icon {
  height: 35rpx;
  width: 40rpx;
}

.pName {
  font-size: 36rpx;
  color: #333333;
  letter-spacing: 0;
  font-weight: 600;
}

.phBottom {
  font-size: 26rpx;
  color: #333333;
  letter-spacing: 0;
  line-height: 37rpx;
  font-weight: 400;
}

.aTis {
  color: #FB6C00;
}

.pList {
  display: flex;
  box-sizing: border-box;
  width: 100%;
  overflow-x: scroll;
  overflow-y: hidden;
}

.pList::-webkit-scrollbar {
  display: none;
  /* WebKit 内核通用 */
  width: 0;
  height: 0;
}

.empty {
  background: #F5F4F9 !important;
}

.pItem {
  margin: 0rpx 10rpx;
  height: 120rpx;
  width: 180rpx;
  background: #FFFFFF;
  border: 2rpx solid rgba(224, 223, 228, 1);
  border-radius: 16rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  flex-direction: column;
  gap: 2rpx;
  flex-shrink: 0;
}

.activeItem {
  background-image: linear-gradient(177deg, #8153FC 0%, #6070FB 82%);
}

.activeItem .ppTitle {
  color: #FFFFFF;
}

.activeItem .ppTime {
  color: #FFFFFF;
}

.pItem:first-child {
  margin-left: 30rpx;
}

.pItem:last-child {
  margin-right: 30rpx;
}

.ppTitle {
  font-size: 30rpx;
  color: #333333;
  text-align: center;
  font-weight: 500;
}

.ppTime {
  font-size: 26rpx;
  color: #666666;
  line-height: 32rpx;
  font-weight: 400;
}

.footer {
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  box-shadow: 0px 2px 10px 0px rgba(0,0,0,0.05);
}

.info {
  display: flex;
  flex-direction: column;
  gap: 30rpx
}

.iTitle {
  font-size: 32rpx;
  color: #333333;
  line-height: 45rpx;
  font-weight: 400;
}

.baseSelect {
  height: 30rpx;
  width: 30rpx;
}

.checkBox {
  display: flex;
  align-items: center;
}

.cbText {
  font-size: 30rpx;
  color: #333333;
  font-weight: 400;
}

.Btn {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.btn {
  height: 92rpx;
  width: 630rpx;
  background-image: linear-gradient(167deg, #8153FC 0%, #6070FB 82%);
  border-radius: 46rpx;
  font-size: 32rpx;
  color: #FFFFFF;
  text-align: center;
  line-height: 48rpx;
  font-weight: 400;
  display: flex;
  justify-content: center;
  align-items: center;
}

.agree{
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.f28 {
  font-size: 28rpx;
  color: #333333;
  letter-spacing: 0;
  line-height: 40rpx;
  font-weight: 400;
}

.purple{
  color: #8153FC;
}