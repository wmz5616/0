/* pages/settleTheOrder/settleTheOrder.wxss */


.pup {
  height: 89rpx;
  width: 100%;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background-color: #FFFFFF;
}

.selectTime {
  height: 100%;
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 30rpx;
  color: #333333;
  text-align: center;
  font-weight: 400;
  padding-left: 30rpx;
}

.up {
  transform: rotate(180deg);
}


.pickerTime {
  height: 110rpx;
  padding: 30rpx;
  box-sizing: border-box;
}

.p_avtiveText {
  font-size: 30rpx;
  color: #8153FC;
  font-weight: 400;
}

.p_text {
  font-size: 36rpx;
  color: #333333;
  text-align: center;
  font-weight: 500;
}

.e_text {
  font-size: 34rpx;
  color: #333333;
  font-weight: 400;
}

.pTab .van-picker__cancel,
.pTab .van-picker__confirm {
  font-size: 30rpx;
  color: #04C0D9;
  font-weight: 400;
}

.pTab .van-picker__title {
  font-size: 36rpx;
  color: #333333;
  text-align: center;
  font-weight: 500;
}

.flex {
  display: flex;
  align-items: center;
  justify-content: space-between;
}


.tis {
  font-size: 30rpx;
  color: #FF6010;
  font-weight: 400;
  height: 72rpx;
  width: 100%;
  display: flex;
  align-items: center;
  padding: 0 30rpx;
  box-sizing: border-box;
  background: #FDFCEC;
}

.swiper {
  padding: 15rpx 30rpx 30rpx 30rpx;
  overflow-y: scroll;
  height: calc(100vh - 532rpx);
}

.table {
  background: #FFFFFF;
  box-shadow: 0px 2rpx 10rpx 0rpx rgba(0, 0, 0, 0.05);
  border-radius: 18rpx;
}

.tHeader {
  display: flex;
  align-items: center;
  height: 104rpx;
  width: 100%;
  background: #F7F4FF;
}

.hText {
  text-align: center;
  flex-grow: 1;
  font-size: 32rpx;
  color: #333333;
  line-height: 40rpx;
  font-weight: 500;
}

.tBody {
  display: flex;
  flex-direction: column;
}

.tItem {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  grid-template-rows: repeat(1, auto);
  gap: 60rpx;
  padding: 0px 30rpx;
}

.fw400 {
  font-weight: 400;
  padding: 30rpx 0rpx;
  box-sizing: border-box;
}

.tFooter {
  border-top: 2rpx solid #D8D8D8;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.btn {
  background: #FFFFFF;
  border: 1rpx solid rgba(221, 221, 221, 1);
  border-radius: 10rpx !important;
  height: 94rpx !important;
  width: 168rpx !important;
  font-size: 32rpx !important;
  color: #000000 !important;
  line-height: 36rpx !important;
  font-weight: 400 !important;
}

.basePage {
  font-size: 36rpx;
  color: #000000;
  line-height: 54rpx;
  font-weight: 400;
}

.purple {
  color: #8153FC;
}

.Btn{
  width: 100%;
  display: flex;
  justify-content: center;
  padding-bottom: 60rpx;
}

.btn1 {
  height: 92rpx;
  width: 630rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-image: linear-gradient(167deg, #8153FC 0%, #6070FB 82%);
  border-radius: 46rpx;
  font-size: 32rpx;
  color: #FFFFFF;
  text-align: center;
  line-height: 48rpx;
  font-weight: 400;
}