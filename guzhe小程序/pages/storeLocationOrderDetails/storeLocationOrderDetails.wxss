.bc {
  height: 100vh;
  background-color: #f9f9f9;
  position: relative;
  overflow: hidden;
}

.flex {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.swiper {
  padding: 30rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  overflow-y: auto;
  overflow-x: hidden;
  height: calc(100vh - 302rpx);
}

.paysg {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
  padding: 30rpx;
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
}


.link {
  padding-bottom: 30rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #DDDDDD;
}

.paysg .text {
  font-size: 28rpx;
  color: #333333;
  font-weight: 400;
  align-items: flex-start;
  gap: 20rpx;
}

.paysg .info {
  display: flex;
  flex-direction: column;
  gap: 17rpx;
}

.copy {
  background: #F8F8F8 !important;
  border: 1rpx solid rgba(224, 223, 228, 1) !important;
  border-radius: 20rpx !important;
  height: 40rpx !important;
  width: 84rpx !important;
  font-size: 22rpx !important;
  padding: 0rpx !important;
  color: #5D5C61 !important;
  line-height: 36rpx !important;
  font-weight: 400;
}

.grayText {
  font-size: 30rpx;
  color: #5D5C61;
  font-weight: 400;
  flex-shrink: 0;
}

.grayType {
  color: #999999 !important;
}

.shopName {
  font-size: 30rpx;
  color: #333333;
  letter-spacing: 0;
  line-height: 51rpx;
  font-weight: 500;
}

.time {
  font-size: 30rpx;
  color: #333333;
  line-height: 48rpx;
  font-weight: 400;
}

.checkBox {
  display: flex;
  align-items: center;
}

.baseSelect {
  height: 30rpx;
  width: 30rpx;
}

.cbText {
  font-size: 30rpx;
  color: #333333;
  font-weight: 400;
}

.footer1 {
  padding: 0rpx 30rpx 30rpx 30rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.isIOS {
  padding-bottom: env(safe-area-inset-bottom) !important;
}


.btnText {
  font-size: 32rpx;
  color: #FFFFFF;
  text-align: center;
  line-height: 48rpx;
  font-weight: 400;
}

.Btn {
  background-image: linear-gradient(167deg, #8153FC 0%, #6A67FB 56%, #6A67FB 56%, #6070FB 82%);
  border-radius: 46rpx;
  height: 92rpx;
  width: 630rpx;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 10rpx;
}

.h336{
  height: calc(100vh - 336rpx) !important;
}